DEVILUDO_RELEASE_VERSION=v1.0.0
DEVILUDO_RELEASE_BASE_URL=https://github.com/OWNER/DeviLudo/releases/download
DEVILUDO_COSIGN_IDENTITY_REGEXP=^https://github.com/OWNER/DeviLudo/.github/workflows/release.yml@
DEVILUDO_COSIGN_ISSUER=https://token.actions.githubusercontent.com
DEVILUDO_RELEASE_AUTH_HEADER_FILE=/etc/deviludo/input/github-release.header
DEVILUDO_GHCR_USERNAME=OWNER
DEVILUDO_GHCR_TOKEN_FILE=/etc/deviludo/input/ghcr.token
DEVILUDO_DATABASE_OWNER_URL_FILE=/etc/deviludo/input/database-owner.url
DEVILUDO_DATABASE_API_URL_FILE=/etc/deviludo/input/database-api.url
DEVILUDO_DATABASE_SCHEDULER_URL_FILE=/etc/deviludo/input/database-scheduler.url
DEVILUDO_DATABASE_SANDBOX_URL_FILE=/etc/deviludo/input/database-sandbox.url
DEVILUDO_S3_ENDPOINT=https://s3.example
DEVILUDO_S3_PUBLIC_ENDPOINT=https://artifacts.example
DEVILUDO_S3_REGION=us-east-1
DEVILUDO_S3_PATH_STYLE=0
DEVILUDO_S3_CREATE_BUCKET=0
DEVILUDO_ARTIFACT_BUCKET=deviludo-artifacts
DEVILUDO_S3_CREDENTIALS_FILE=/etc/deviludo/input/s3.credentials
DEVILUDO_VAULT_ADDR=https://vault.example
DEVILUDO_VAULT_ADMIN_TOKEN_FILE=/etc/deviludo/input/vault-admin.token
DEVILUDO_VAULT_TOKEN_FILE=/etc/deviludo/input/vault-api.token
DEVILUDO_VAULT_EXECUTOR_TOKEN_FILE=/etc/deviludo/input/vault-executor.token
DEVILUDO_VAULT_PKI_TOKEN_FILE=/etc/deviludo/input/vault-pki.token
DEVILUDO_OTEL_ENDPOINT=https://otel.example/v1/traces
DEVILUDO_TLS_CERT_FILE=/etc/deviludo/input/core.crt
DEVILUDO_TLS_KEY_FILE=/etc/deviludo/input/core.key
DEVILUDO_TLS_SERVER_CA_FILE=/etc/deviludo/input/core-server-ca.crt
DEVILUDO_TLS_CLIENT_CA_FILE=/etc/deviludo/input/e2e-ca.crt
DEVILUDO_WEB_CORE_TOKEN_FILE=/etc/deviludo/input/web-core.token
DEVILUDO_ACCESS_MODE=platform
DEVILUDO_PLATFORM_ACCOUNT_API_URL=https://account.internal.example
DEVILUDO_PLATFORM_INTERNAL_TOKEN_FILE=/etc/deviludo/input/platform-internal.token
DEVILUDO_PROJECTS_ROOT=/var/lib/deviludo-projects
DEVILUDO_E2E_REVALIDATION_BATCH_SIZE=2
DEVILUDO_CORE_BIND_ADDRESS=10.0.0.20
DEVILUDO_CORE_ALLOWED_CIDRS=10.0.0.10/32,10.0.1.0/24
DEVILUDO_SSH_ALLOWED_CIDRS=10.0.9.0/24
DEVILUDO_PROVIDER_ALLOWLIST=api.anthropic.com,api.openai.com
DEVILUDO_STEAM_ALLOWLIST=api.steampowered.com,partner.steamgames.com,content.steampowered.com,client-download.steampowered.com,steamcdn-a.akamaihd.net
DEVILUDO_STEAM_APP_ID=1000000
DEVILUDO_STEAM_DEPOT_LINUX=1000001
DEVILUDO_STEAM_DEPOT_WINDOWS=1000002
DEVILUDO_STEAM_DEPOT_MACOS=1000003
DEVILUDO_DOCKER_CE_VERSION=REPLACE_WITH_DOCKER_CE_APT_VERSION
DEVILUDO_CONTAINERD_VERSION=REPLACE_WITH_CONTAINERD_APT_VERSION
DEVILUDO_BUILDX_VERSION=REPLACE_WITH_BUILDX_APT_VERSION
DEVILUDO_COMPOSE_VERSION=REPLACE_WITH_COMPOSE_APT_VERSION

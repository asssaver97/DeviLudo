FROM node:22.22.0-bookworm-slim
ARG GODOT_VERSION=4.5.1
ARG TARGETARCH
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl fontconfig libfontconfig1 tar unzip \
 && case "$TARGETARCH" in amd64) godot_arch=x86_64 ;; arm64) godot_arch=arm64 ;; *) exit 1 ;; esac \
 && curl -fsSL "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_linux.${godot_arch}.zip" -o /tmp/godot.zip \
 && curl -fsSL "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_export_templates.tpz" -o /tmp/templates.tpz \
 && unzip /tmp/godot.zip -d /usr/local/bin \
 && mv "/usr/local/bin/Godot_v${GODOT_VERSION}-stable_linux.${godot_arch}" /usr/local/bin/godot \
 && chmod 0555 /usr/local/bin/godot \
 && useradd --create-home --uid 10001 task \
 && install -d -o 10001 -g 10001 "/home/task/.local/share/godot/export_templates/${GODOT_VERSION}.stable" \
 && unzip /tmp/templates.tpz -d /tmp/templates \
 && mv /tmp/templates/templates/* "/home/task/.local/share/godot/export_templates/${GODOT_VERSION}.stable/" \
 && chown -R 10001:10001 /home/task/.local \
 && rm -rf /var/lib/apt/lists/* /tmp/godot.zip /tmp/templates.tpz /tmp/templates
COPY services/sandbox-executor/task-runner.mjs /usr/local/bin/deviludo-task
COPY services/sandbox-executor/task-io.mjs /usr/local/bin/deviludo-task-io
COPY services/sandbox-executor/godot-build.mjs /usr/local/bin/godot-build.mjs
COPY scripts/e2e-evidence.mjs /usr/local/lib/deviludo/e2e-evidence.mjs
RUN chmod 0555 /usr/local/bin/deviludo-task /usr/local/bin/deviludo-task-io
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/deviludo-task"]

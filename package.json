{
  "name": "deviludo-control-plane",
  "version": "0.1.0-beta.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "local:dev": "node scripts/local/start.mjs",
    "local:smoke": "node scripts/local/smoke.mjs",
    "test": "npm run build && node --import tsx --test tests/*.test.mjs && npm run test:services",
    "test:unit": "node --import tsx --test tests/domain-contracts.test.mjs tests/runtime-security.test.mjs tests/workflow.test.mjs",
    "test:services": "tsc -p services/control-plane/tsconfig.json --pretty false && tsc -p services/temporal/tsconfig.json --pretty false && node --import tsx --test services/control-plane/test/control-plane.test.ts services/temporal/test/temporal-adapter.test.ts && npm run test:agent-worker",
    "test:agent-worker": "tsc -p services/agent-worker/tsconfig.json --pretty false && node --import tsx --test services/agent-worker/test/supervisor.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "start:control-plane": "node --import tsx services/control-plane/src/main.ts",
    "start:temporal-worker": "node --import tsx services/temporal/src/run-worker.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@temporalio/client": "1.20.3",
    "@temporalio/worker": "1.20.3",
    "@temporalio/workflow": "1.20.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

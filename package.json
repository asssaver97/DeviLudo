{
  "name": "deviludo-control-plane",
  "version": "0.1.0-beta.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "local:dev": "node scripts/local/start.mjs",
    "local:smoke": "node scripts/local/smoke.mjs",
    "test": "npm run build && DEVILUDO_LOCAL_TEST_MODE=1 node --import tsx --test tests/*.test.mjs && npm run test:services",
    "test:unit": "node --import tsx --test tests/domain-contracts.test.mjs tests/runtime-security.test.mjs tests/workflow.test.mjs",
    "test:services": "tsc -p services/control-plane/tsconfig.json --pretty false && tsc -p services/temporal/tsconfig.json --pretty false && node --import tsx --test services/control-plane/test/*.test.ts services/temporal/test/temporal-adapter.test.ts && npm run test:delivery-projection && npm run test:agent-supply-chain && npm run test:agent-worker && npm run test:agent-configuration && npm run test:agent-execution-broker && npm run test:inference-gateway && npm run test:spec-dialogue && npm run test:spec-workflow-bridge && npm run test:user-acceptance && npm run test:scm-proxy && npm run test:artifact-preparer && npm run test:runner-control && npm run test:evidence-archive && npm run test:godot-testkit && npm run test:steam-publisher && npm run test:steam-client-connector && npm run test:local-runtime && npm run test:local-agent-runtime && npm run test:local-spec-runtime",
    "test:delivery-projection": "tsc -p services/delivery-projection/tsconfig.json --pretty false && node --import tsx --test services/delivery-projection/test/*.test.ts",
    "test:spec-dialogue": "tsc -p services/spec-dialogue/tsconfig.json --pretty false && node --import tsx --test services/spec-dialogue/test/*.test.ts",
    "test:spec-workflow-bridge": "tsc -p services/spec-workflow-bridge/tsconfig.json --pretty false && node --import tsx --test services/spec-workflow-bridge/test/*.test.ts",
    "test:user-acceptance": "tsc -p services/user-acceptance/tsconfig.json --pretty false && node --import tsx --test services/user-acceptance/test/*.test.ts",
    "test:local-spec-runtime": "tsc -p services/local-spec-runtime/tsconfig.json --pretty false && node --import tsx --test services/local-spec-runtime/test/*.test.ts",
    "test:agent-supply-chain": "tsc -p services/agent-supply-chain/tsconfig.json --pretty false && node --import tsx --test services/agent-supply-chain/test/*.test.ts",
    "test:agent-worker": "tsc -p services/agent-worker/tsconfig.json --pretty false && node --import tsx --test services/agent-worker/test/*.test.ts",
    "test:agent-configuration": "tsc -p services/agent-configuration/tsconfig.json --pretty false && node --import tsx --test services/agent-configuration/test/*.test.ts",
    "test:agent-execution-broker": "tsc -p services/agent-execution-broker/tsconfig.json --pretty false && node --import tsx --test services/agent-execution-broker/test/*.test.ts",
    "test:inference-gateway": "tsc -p services/inference-gateway/tsconfig.json --pretty false && node --import tsx --test services/inference-gateway/test/*.test.ts",
    "test:scm-proxy": "tsc -p services/scm-proxy/tsconfig.json --pretty false && node --import tsx --test services/scm-proxy/test/*.test.ts",
    "test:runner-control": "tsc -p services/runner-control/tsconfig.json --pretty false && node --import tsx --test services/runner-control/test/*.test.ts",
    "test:godot-testkit": "tsc -p services/godot-testkit/tsconfig.json --pretty false && node --import tsx --test services/godot-testkit/test/*.test.ts",
    "test:artifact-preparer": "tsc -p services/artifact-preparer/tsconfig.json --pretty false && node --import tsx --test services/artifact-preparer/test/*.test.ts",
    "test:evidence-archive": "tsc -p services/evidence-archive/tsconfig.json --pretty false && node --import tsx --test services/evidence-archive/test/*.test.ts",
    "test:steam-publisher": "tsc -p services/steam-publisher/tsconfig.json --pretty false && node --import tsx --test services/steam-publisher/test/*.test.ts",
    "test:steam-client-connector": "tsc -p services/steam-client-connector/tsconfig.json --pretty false && node --import tsx --test services/steam-client-connector/test/*.test.ts",
    "test:local-runtime": "tsc -p services/local-runtime/tsconfig.json --pretty false && node --import tsx --test services/local-runtime/test/godot-fixture.test.ts",
    "test:local-agent-runtime": "tsc -p services/local-agent-runtime/tsconfig.json --pretty false && node --import tsx --test services/local-agent-runtime/test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "start:control-plane": "node --import tsx services/control-plane/src/main.ts",
    "start:agent-supply-chain": "node --import tsx services/agent-supply-chain/src/run-service.ts",
    "build:agent-supply-chain-native": "node scripts/build-agent-supply-chain-native.mjs",
    "start:agent-supply-chain-native": "node --import tsx services/agent-supply-chain/src/run-native-policy.ts",
    "start:control-plane-workflow": "node --import tsx services/control-plane/src/run-workflow-service.ts",
    "start:agent-worker-workflow": "node --import tsx services/agent-worker/src/run-workflow-service.ts",
    "start:agent-configuration": "node --import tsx services/agent-configuration/src/run-service.ts",
    "start:agent-execution-broker": "node --import tsx services/agent-execution-broker/src/run-broker-service.ts",
    "start:agent-execution-worker": "node --import tsx services/agent-execution-broker/src/run-native-worker-service.ts",
    "start:agent-microvm-guest": "node --import tsx services/agent-execution-broker/src/run-native-microvm-guest-service.ts",
    "start:inference-gateway": "node --import tsx services/inference-gateway/src/run-service.ts",
    "start:spec-dialogue": "node --import tsx services/spec-dialogue/src/run-service.ts",
    "start:spec-workflow-bridge": "node --import tsx services/spec-workflow-bridge/src/run-service.ts",
    "start:user-acceptance": "node --import tsx services/user-acceptance/src/run-service.ts",
    "start:runner-control-workflow": "node --import tsx services/runner-control/src/run-workflow-service.ts",
    "start:runner-ingress": "node --import tsx services/runner-control/src/run-ingress-service.ts",
    "start:evidence-archive": "node --import tsx services/evidence-archive/src/run-service.ts",
    "start:physical-runner": "node --import tsx services/runner-control/src/run-physical-runner.ts",
    "start:godot-testkit": "node --import tsx services/godot-testkit/src/run-cli.ts",
    "start:scm-proxy-workflow": "node --import tsx services/scm-proxy/src/run-workflow-service.ts",
    "start:scm-candidate-broker": "node --import tsx services/scm-proxy/src/run-candidate-publication-service.ts",
    "start:scm-merge-broker": "node --import tsx services/scm-proxy/src/run-merge-service.ts",
    "start:github-authorization": "node --import tsx services/scm-proxy/src/run-github-authorization-service.ts",
    "start:source-snapshot": "node --import tsx services/scm-proxy/src/run-source-snapshot-service.ts",
    "start:artifact-preparer": "node --import tsx services/artifact-preparer/src/run-service.ts",
    "start:steam-publisher-workflow": "node --import tsx services/steam-publisher/src/run-workflow-service.ts",
    "start:steam-workflow-broker": "node --import tsx services/steam-publisher/src/run-workflow-broker-service.ts",
    "start:steam-workflow-executor": "node --import tsx services/steam-publisher/src/run-workflow-executor-service.ts",
    "start:steam-client-connector": "node --import tsx services/steam-client-connector/src/run-service.ts",
    "start:steam-install-services": "node --import tsx services/steam-publisher/src/run-clean-install-services.ts",
    "start:temporal-worker": "node --import tsx services/temporal/src/run-worker.ts",
    "start:delivery-projection": "node --import tsx services/delivery-projection/src/run-service.ts",
    "start:local-runtime": "node --import tsx services/local-runtime/src/server.ts",
    "start:local-agent-runtime": "node --import tsx services/local-agent-runtime/src/server.ts",
    "start:local-spec-runtime": "node --import tsx services/local-spec-runtime/src/server.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@temporalio/client": "1.20.3",
    "@temporalio/worker": "1.20.3",
    "@temporalio/workflow": "1.20.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "next": "16.2.6",
    "pg": "8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

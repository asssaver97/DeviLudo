{
  "name": "deviludo",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "core": "node --import tsx services/core/src/main.ts",
    "core:api": "DEVILUDO_CORE_ROLE=api npm run core",
    "core:scheduler": "DEVILUDO_CORE_ROLE=scheduler npm run core",
    "core:sandbox": "DEVILUDO_CORE_ROLE=sandbox npm run core",
    "e2e-node": "node --import tsx services/e2e-node/src/main.ts",
    "local:up": "node scripts/local-up.mjs",
    "local:prepare": "node scripts/local-prepare.mjs",
    "local:e2e": "node --import tsx scripts/local-macos-e2e.mjs",
    "local:test": "node scripts/local-integration-test.mjs",
    "local:down": "node scripts/local-down.mjs",
    "local:reset": "node scripts/local-down.mjs --volumes",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test": "npm run typecheck && npm run test:unit && npm run verify:architecture",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "fastify": "5.10.0",
    "next": "16.2.6",
    "pg": "8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "4.22.1"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  }
}

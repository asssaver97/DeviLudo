# syntax=docker/dockerfile:1.7
FROM node:22.22.0-bookworm-slim
ARG CODEX_CLI_VERSION=0.149.0
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
RUN --mount=type=cache,target=/root/.npm apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates unzip \
 && rm -rf /var/lib/apt/lists/* \
 && npm install --global --no-audit --no-fund "@openai/codex@${CODEX_CLI_VERSION}" \
 && useradd --create-home --uid 10001 task
COPY services/sandbox-executor/task-runner.mjs /usr/local/bin/deviludo-task
COPY services/sandbox-executor/task-io.mjs /usr/local/bin/deviludo-task-io
COPY services/sandbox-executor/build-asset-usage.mjs /usr/local/bin/build-asset-usage.mjs
COPY scripts/e2e-evidence.mjs /usr/local/lib/deviludo/e2e-evidence.mjs
RUN chmod 0555 /usr/local/bin/deviludo-task /usr/local/bin/deviludo-task-io
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/deviludo-task"]

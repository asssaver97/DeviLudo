ARG NODE_BASE_IMAGE
FROM ${NODE_BASE_IMAGE} AS dependencies

WORKDIR /workspace
ENV NODE_ENV=production \
    NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

ARG NATIVE_PUBLISHER_IMAGE
FROM ${NATIVE_PUBLISHER_IMAGE} AS native-publisher

FROM ${NODE_BASE_IMAGE} AS runtime

ARG DEVILUDO_PLATFORM_VERSION
ARG DEVILUDO_SOURCE_REVISION

LABEL org.opencontainers.image.title="DeviLudo Steam Workflow Executor" \
      org.opencontainers.image.version="${DEVILUDO_PLATFORM_VERSION}" \
      org.opencontainers.image.revision="${DEVILUDO_SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/asssaver97/DeviLudo" \
      deviludo.io/workload="steam-workflow-executor"

WORKDIR /workspace
ENV NODE_ENV=production \
    NODE_OPTIONS=--enable-source-maps \
    NODE_PATH="" \
    HOME=/nonexistent \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH="" \
    LD_PRELOAD="" \
    DEVILUDO_CONTAINER_KIND=steam-workflow-executor \
    DEVILUDO_STEAM_EXECUTOR_NATIVE_EXECUTABLE=/opt/deviludo/bin/native-steam-publisher \
    DEVILUDO_STEAM_EXECUTOR_NATIVE_CONFIG_FILE=/opt/deviludo/config/native-steam-publisher.json \
    DEVILUDO_STEAM_EXECUTOR_WORK_ROOT=/var/lib/deviludo/steam-publisher \
    DEVILUDO_STEAM_EXECUTOR_READY_FILE=/tmp/deviludo-steam-executor-ready

RUN mkdir -p /var/lib/deviludo/steam-publisher /opt/deviludo/bin /opt/deviludo/config \
    && chown -R node:node /var/lib/deviludo/steam-publisher \
    && chmod 0700 /var/lib/deviludo/steam-publisher \
    && chmod 0755 /opt/deviludo /opt/deviludo/bin /opt/deviludo/config

COPY --from=dependencies --chown=node:node /workspace/node_modules ./node_modules
COPY --from=native-publisher --chown=node:node /opt/deviludo/bin/native-steam-publisher /opt/deviludo/bin/native-steam-publisher
COPY --from=native-publisher --chown=node:node /opt/deviludo/config/native-steam-publisher.json /opt/deviludo/config/native-steam-publisher.json
COPY --chown=node:node package.json tsconfig.json ./
COPY --chown=node:node lib ./lib
COPY --chown=node:node scripts/observability ./scripts/observability
COPY --chown=node:node scripts/production/run-steam-workflow-executor-container.mjs ./scripts/production/run-steam-workflow-executor-container.mjs
COPY --chown=node:node services/steam-publisher ./services/steam-publisher
COPY --chown=node:node services/evidence-archive/src ./services/evidence-archive/src
COPY --chown=node:node services/runner-control/src ./services/runner-control/src
COPY --chown=node:node services/temporal/src ./services/temporal/src

USER node
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/local/bin/node", "--import", "tsx", "scripts/production/run-steam-workflow-executor-container.mjs"]

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=DeviLudoVhfGamepad.cat
DriverVer=08/13/2026,1.0.0.0
PnpLockdown=1

[Manufacturer]
%ProviderName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=Install,Root\DeviLudoVhfGamepad

[SourceDisksFiles]
DeviLudoVhfGamepad.sys=1

[SourceDisksNames]
1=%DiskName%,,,

[DestinationDirs]
DefaultDestDir=12

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
DeviLudoVhfGamepad.sys

[Install.NT.Services]
AddService=DeviLudoVhfGamepad,0x00000002,ServiceInstall

[ServiceInstall]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\DeviLudoVhfGamepad.sys

[Install.NT.Wdf]
KmdfService=DeviLudoVhfGamepad,KmdfSection

[KmdfSection]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="DeviLudo"
DeviceName="DeviLudo VHF Virtual Gamepad"
DiskName="DeviLudo VHF Driver"

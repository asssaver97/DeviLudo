ARG NODE_BASE_IMAGE
FROM ${NODE_BASE_IMAGE} AS builder

WORKDIR /workspace
ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_UPDATE_NOTIFIER=false

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY tsconfig.json ./
COPY adapters ./adapters
COPY lib ./lib
COPY services/agent-worker ./services/agent-worker
COPY services/agent-execution-broker ./services/agent-execution-broker
COPY services/runner-control ./services/runner-control
COPY services/scm-proxy ./services/scm-proxy
RUN ./node_modules/.bin/esbuild services/agent-execution-broker/src/run-native-microvm-guest-service.ts \
    --bundle --platform=node --target=node22.13 --format=esm --packages=bundle \
    --legal-comments=none --sourcemap=false --outfile=/agent-microvm-guest-service.mjs

ARG GUEST_BASE_IMAGE
FROM ${GUEST_BASE_IMAGE} AS guest

ARG DEVILUDO_PLATFORM_VERSION
ARG DEVILUDO_SOURCE_REVISION
ARG DEVILUDO_AGENT
ARG DEVILUDO_EXACT_AGENT_VERSION
ARG DEVILUDO_ADAPTER_VERSION
ARG SOURCE_DATE_EPOCH

LABEL org.opencontainers.image.title="DeviLudo Agent microVM guest" \
      org.opencontainers.image.version="${DEVILUDO_PLATFORM_VERSION}" \
      org.opencontainers.image.revision="${DEVILUDO_SOURCE_REVISION}" \
      org.opencontainers.image.source="https://github.com/asssaver97/DeviLudo" \
      deviludo.io/workload="agent-microvm-guest" \
      deviludo.io/agent="${DEVILUDO_AGENT}" \
      deviludo.io/agent-version="${DEVILUDO_EXACT_AGENT_VERSION}" \
      deviludo.io/adapter-version="${DEVILUDO_ADAPTER_VERSION}"

USER 0:0
WORKDIR /workspace
ENV NODE_ENV=production \
    NODE_OPTIONS=--enable-source-maps \
    NODE_PATH="" \
    HOME=/run/deviludo-home \
    PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LD_LIBRARY_PATH="" \
    LD_PRELOAD="" \
    DEVILUDO_CONTAINER_KIND=agent-microvm-guest \
    DEVILUDO_AGENT_UPDATE_POLICY=immutable-image-only \
    DISABLE_UPDATES=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

COPY --from=builder --chmod=0555 /agent-microvm-guest-service.mjs /opt/deviludo/agent-microvm-guest-service.mjs
COPY --chmod=0555 scripts/production/agent-microvm-guest-init.mjs /sbin/deviludo-init

RUN mkdir -p /run/deviludo /run/deviludo-credentials /run/deviludo-home /proc /sys \
    && chmod 0755 /run/deviludo /run/deviludo-credentials /run/deviludo-home /proc /sys \
    && test -x /usr/bin/node \
    && test -x /bin/mount \
    && test -x /bin/umount \
    && test -x /sbin/poweroff

ENTRYPOINT ["/sbin/deviludo-init"]

FROM scratch AS rootfs
COPY --from=guest / /

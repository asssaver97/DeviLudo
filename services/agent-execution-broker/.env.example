DATABASE_URL=postgresql://deviludo-agent-execution-broker@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_HOST=0.0.0.0
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_PORT=4746
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_VERSION=1.0.0
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_BINARY_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_ALLOWED_SPIFFE_IDS=["spiffe://deviludo.internal/service/agent-worker"]
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_TLS_KEY_FILE=/run/secrets/broker-server-key.pem
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_TLS_CERT_FILE=/run/secrets/broker-server.pem
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_CLIENT_CA_FILE=/run/secrets/workload-ca.pem

# Isolated Worker process only. This key is an internal DLRT signing key, never
# a Claude/Codex upstream credential.
DEVILUDO_INFERENCE_RUN_TOKEN_SIGNING_KEY_FILE=/run/secrets/inference-run-token.key
DEVILUDO_AGENT_EXECUTION_WORKER_TENANT_IDS=["11111111-1111-4111-8111-111111111111"]
DEVILUDO_AGENT_EXECUTION_WORKER_LEASE_MS=300000
DEVILUDO_AGENT_EXECUTION_WORKER_POLL_INTERVAL_MS=1000
DEVILUDO_AGENT_EXECUTION_WORKER_RETRY_INTERVAL_MS=5000

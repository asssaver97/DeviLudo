DATABASE_URL=postgresql://deviludo-agent-execution-broker@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_HOST=0.0.0.0
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_PORT=4746
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_MAX_BODY_BYTES=524288
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_REQUEST_TIMEOUT_MS=30000
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_VERSION=1.0.0
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_BINARY_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_ALLOWED_SPIFFE_IDS=["spiffe://deviludo.internal/service/agent-worker"]
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_TLS_KEY_FILE=/run/secrets/broker-server-key.pem
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_TLS_CERT_FILE=/run/secrets/broker-server.pem
DEVILUDO_AGENT_EXECUTION_BROKER_SERVER_CLIENT_CA_FILE=/run/secrets/workload-ca.pem

# Isolated Worker process only. This key is an internal DLRT signing key, never
# a Claude/Codex upstream credential.
DEVILUDO_INFERENCE_RUN_TOKEN_SIGNING_KEY_FILE=/run/secrets/inference-run-token.key
DEVILUDO_AGENT_EXECUTION_WORKER_TENANT_IDS=["11111111-1111-4111-8111-111111111111"]
DEVILUDO_AGENT_EXECUTION_WORKER_BINDING_FILE=/etc/deviludo/agent-execution-worker-binding.json
DEVILUDO_AGENT_EXECUTION_WORKER_BINDING_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DEVILUDO_AGENT_EXECUTION_WORKER_LEASE_MS=300000
DEVILUDO_AGENT_EXECUTION_WORKER_POLL_INTERVAL_MS=1000
DEVILUDO_AGENT_EXECUTION_WORKER_RETRY_INTERVAL_MS=5000

# Exact executing host Worker bundle. Verification happens before PostgreSQL,
# Vault or any Broker client is constructed. These files are root-owned and
# read-only; the trust policy uses a key distinct from Launcher and Guest keys.
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_ARTIFACT_FILE=/opt/deviludo/bin/deviludo-agent-execution-worker-native.mjs
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_ARTIFACT_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_BUILD_RECEIPT_FILE=/opt/deviludo/releases/agent-execution-worker-native-build-receipt.json
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_BUILD_RECEIPT_DIGEST=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_RELEASE_FILE=/opt/deviludo/releases/agent-execution-worker-native-release.json
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_TRUST_POLICY_FILE=/opt/deviludo/policies/agent-execution-worker-native-trust-policy.json
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_TRUST_POLICY_DIGEST=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
DEVILUDO_SCM_CANDIDATE_BROKER_URL=https://scm-candidate.internal:4545/v1/candidates
DEVILUDO_SCM_CANDIDATE_BROKER_TLS_KEY_FILE=/run/secrets/scm-candidate-client.key
DEVILUDO_SCM_CANDIDATE_BROKER_TLS_CERT_FILE=/run/secrets/scm-candidate-client.crt
DEVILUDO_SCM_CANDIDATE_BROKER_CA_FILE=/run/secrets/scm-candidate-ca.crt
DEVILUDO_SCM_CANDIDATE_BROKER_TIMEOUT_MS=120000

# Audited one-run-per-microVM launcher. The private candidate-attestation key
# stays inside the guest/KMS boundary; this process loads only its public key.
DEVILUDO_AGENT_MICROVM_EXECUTABLE=/opt/deviludo/bin/agent-microvm-launcher
DEVILUDO_AGENT_MICROVM_EXECUTABLE_DIGEST=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
DEVILUDO_AGENT_MICROVM_CONFIG_FILE=/etc/deviludo/agent-microvm-launcher.json
DEVILUDO_AGENT_MICROVM_CONFIG_DIGEST=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
DEVILUDO_AGENT_MICROVM_BUILD_RECEIPT_FILE=/opt/deviludo/releases/agent-microvm-launcher-build-receipt.json
DEVILUDO_AGENT_MICROVM_RELEASE_FILE=/opt/deviludo/releases/agent-microvm-launcher-release.json
DEVILUDO_AGENT_MICROVM_TRUST_POLICY_FILE=/opt/deviludo/policies/agent-microvm-launcher-trust-policy.json
DEVILUDO_AGENT_MICROVM_TRUST_POLICY_DIGEST=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
DEVILUDO_AGENT_MICROVM_WORK_ROOT=/var/lib/deviludo/agent-microvms
DEVILUDO_AGENT_MICROVM_TIMEOUT_SECONDS=7200
DEVILUDO_AGENT_MICROVM_HEARTBEAT_SECONDS=30
DEVILUDO_AGENT_MICROVM_ATTESTATION_KEY_ID=microvm-attestation-v1
DEVILUDO_AGENT_MICROVM_ATTESTATION_PUBLIC_KEY_FILE=/run/keys/microvm-attestation-v1.pem
DEVILUDO_AGENT_INFERENCE_GATEWAY_URL=https://inference-gateway.internal/

# Worker-only bootstrap identity. The issuer returns one short-lived ext4 image
# bound to tenant/project/run/attempt and never returns an upstream Provider key.
DEVILUDO_AGENT_MICROVM_CREDENTIAL_ISSUER_URL=https://guest-credentials.internal/
DEVILUDO_AGENT_MICROVM_CREDENTIAL_ISSUER_TLS_KEY_FILE=/run/secrets/guest-credential-issuer-client.key
DEVILUDO_AGENT_MICROVM_CREDENTIAL_ISSUER_TLS_CERT_FILE=/run/secrets/guest-credential-issuer-client.crt
DEVILUDO_AGENT_MICROVM_CREDENTIAL_ISSUER_CA_FILE=/run/secrets/guest-credential-issuer-ca.crt
DEVILUDO_AGENT_MICROVM_CREDENTIAL_ISSUER_TIMEOUT_MS=30000

# Offline release finalizer only. The signing key remains in the dedicated KMS
# route and is never mounted into the Worker or launcher process.
DEVILUDO_AGENT_MICROVM_SIGNER_ENDPOINT=https://agent-microvm-kms.internal:8443/
DEVILUDO_AGENT_MICROVM_SIGNER_TLS_KEY_FILE=/run/release-secrets/client.key
DEVILUDO_AGENT_MICROVM_SIGNER_TLS_CERT_FILE=/run/release-secrets/client.crt
DEVILUDO_AGENT_MICROVM_SIGNER_TLS_CA_FILE=/run/release-secrets/ca.crt
DEVILUDO_AGENT_MICROVM_SIGNING_KEY_ID=agent-microvm-launcher-2026-01

# Offline Agent execution Worker finalizer only. The Worker host never receives
# this mTLS identity or the underlying Ed25519 private key.
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_SIGNER_ENDPOINT=https://agent-worker-kms.internal:8443/
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_SIGNER_TLS_KEY_FILE=/run/release-secrets/agent-worker-client.key
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_SIGNER_TLS_CERT_FILE=/run/release-secrets/agent-worker-client.crt
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_SIGNER_TLS_CA_FILE=/run/release-secrets/agent-worker-ca.crt
DEVILUDO_AGENT_EXECUTION_WORKER_NATIVE_SIGNING_KEY_ID=agent-execution-worker-native-2026-01

# Offline Guest rootfs finalizer. This is a separate release key/trust domain
# from the privileged host Launcher, so either artifact can be revoked alone.
DEVILUDO_AGENT_MICROVM_GUEST_KMS_URL=https://agent-microvm-kms.internal:8443/
DEVILUDO_AGENT_MICROVM_GUEST_KMS_TLS_KEY_FILE=/run/release-secrets/guest-client.key
DEVILUDO_AGENT_MICROVM_GUEST_KMS_TLS_CERT_FILE=/run/release-secrets/guest-client.crt
DEVILUDO_AGENT_MICROVM_GUEST_KMS_CA_FILE=/run/release-secrets/guest-ca.crt
DEVILUDO_AGENT_MICROVM_GUEST_KMS_KEY_ID=agent-microvm-guest-2026-01

# Vault/KMS facade for depositing and revoking the expiring DLRT. Token bytes
# are sent as application/octet-stream over mTLS and are never JSON encoded.
DEVILUDO_EPHEMERAL_SECRET_BROKER_URL=https://ephemeral-secrets.internal/
DEVILUDO_EPHEMERAL_SECRET_TLS_KEY_FILE=/run/secrets/ephemeral-secret-client.key
DEVILUDO_EPHEMERAL_SECRET_TLS_CERT_FILE=/run/secrets/ephemeral-secret-client.crt
DEVILUDO_EPHEMERAL_SECRET_CA_FILE=/run/secrets/ephemeral-secret-ca.crt
DEVILUDO_EPHEMERAL_SECRET_TIMEOUT_MS=30000

# Read-only locked-baseline source Broker and immutable object transfer.
DEVILUDO_SOURCE_SNAPSHOT_BROKER_URL=https://source-snapshot.internal/
DEVILUDO_SOURCE_SNAPSHOT_TLS_KEY_FILE=/run/secrets/source-snapshot-client.key
DEVILUDO_SOURCE_SNAPSHOT_TLS_CERT_FILE=/run/secrets/source-snapshot-client.crt
DEVILUDO_SOURCE_SNAPSHOT_CA_FILE=/run/secrets/source-snapshot-ca.crt
DEVILUDO_SOURCE_SNAPSHOT_TRANSFER_CA_FILE=/run/secrets/source-transfer-ca.crt
DEVILUDO_SOURCE_SNAPSHOT_ALLOWED_TRANSFER_ORIGINS_JSON=["https://objects.internal"]

# Guest-image entry only. These paths exist inside the one-run microVM, not on
# the execution Worker host. The guest uses its own workload certificate for
# one exact SecretRef resolution and holds the candidate key only inside the
# sealed guest/KMS boundary.
DEVILUDO_MICROVM_GUEST_RUN_ROOT=/run/deviludo
DEVILUDO_MICROVM_GUEST_WORKSPACE_ROOT=/run/deviludo/workspace
DEVILUDO_MICROVM_GUEST_REQUEST_FILE=/run/deviludo/control/request.json
DEVILUDO_MICROVM_GUEST_RESPONSE_FILE=/run/deviludo/control/response.json
DEVILUDO_MICROVM_GUEST_ATTESTATION_KEY_ID=microvm-attestation-v1
DEVILUDO_MICROVM_GUEST_ATTESTATION_PRIVATE_KEY_FILE=/run/deviludo-credentials/microvm-attestation-v1.pem

# The relay certificate has a 127.0.0.1 IP SAN and its CA is fixed in the
# immutable image. Claude/Codex connect here; they never receive a DLRT.
DEVILUDO_MICROVM_GUEST_RELAY_ORIGIN=https://127.0.0.1:8443/
DEVILUDO_MICROVM_GUEST_RELAY_TLS_KEY_FILE=/run/deviludo-credentials/relay-server.key
DEVILUDO_MICROVM_GUEST_RELAY_TLS_CERT_FILE=/run/deviludo-credentials/relay-server.crt

# Separate guest workload identity used only from the loopback relay to the
# internal inference Gateway. It is not an upstream Provider credential.
DEVILUDO_MICROVM_GUEST_GATEWAY_TLS_KEY_FILE=/run/deviludo-credentials/inference-gateway-client.key
DEVILUDO_MICROVM_GUEST_GATEWAY_TLS_CERT_FILE=/run/deviludo-credentials/inference-gateway-client.crt
DEVILUDO_MICROVM_GUEST_GATEWAY_CA_FILE=/run/deviludo-credentials/inference-gateway-ca.crt

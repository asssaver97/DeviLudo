NODE_ENV=production
DATABASE_URL=postgresql://deviludo-agent-credential-issuer@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Dedicated TLS 1.3 listener. Only the isolated Agent execution Worker may
# request an image; health probes use the same authenticated identity.
DEVILUDO_GUEST_CREDENTIAL_ISSUER_HOST=0.0.0.0
DEVILUDO_GUEST_CREDENTIAL_ISSUER_PORT=4673
DEVILUDO_GUEST_CREDENTIAL_ISSUER_REQUEST_TIMEOUT_SECONDS=60
DEVILUDO_GUEST_CREDENTIAL_ISSUER_SERVER_TLS_KEY_FILE=/run/secrets/guest-credential-issuer/server.key
DEVILUDO_GUEST_CREDENTIAL_ISSUER_SERVER_TLS_CERT_FILE=/run/secrets/guest-credential-issuer/server.crt
DEVILUDO_GUEST_CREDENTIAL_ISSUER_CLIENT_CA_FILE=/run/secrets/guest-credential-issuer/agent-worker-ca.crt
DEVILUDO_GUEST_CREDENTIAL_ISSUER_WORKER_SPIFFE_ID=spiffe://deviludo.internal/agent-execution/native-worker

# The work root must be a private, memory-backed volume. mke2fs is installed
# only in this issuer image and is verified before every build.
DEVILUDO_GUEST_CREDENTIAL_ISSUER_WORK_ROOT=/run/deviludo-credential-images
DEVILUDO_GUEST_CREDENTIAL_ISSUER_MKE2FS_EXECUTABLE=/usr/sbin/mke2fs
DEVILUDO_GUEST_CREDENTIAL_ISSUER_MKE2FS_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

# Candidate signing material and guest-only workload certificates. None of
# these files are mounted into the Agent execution Worker or control plane.
DEVILUDO_GUEST_CREDENTIAL_ISSUER_ATTESTATION_KEY_ID=microvm-attestation-v1
DEVILUDO_GUEST_CREDENTIAL_ISSUER_ATTESTATION_PRIVATE_KEY_FILE=/run/secrets/guest-credential-issuer/attestation-private.pem
DEVILUDO_GUEST_CREDENTIAL_ISSUER_RELAY_TLS_KEY_FILE=/run/secrets/guest-credential-issuer/relay-server.key
DEVILUDO_GUEST_CREDENTIAL_ISSUER_RELAY_TLS_CERT_FILE=/run/secrets/guest-credential-issuer/relay-server.crt
DEVILUDO_GUEST_CREDENTIAL_ISSUER_RELAY_ORIGIN=https://127.0.0.1:8443/
DEVILUDO_GUEST_CREDENTIAL_ISSUER_GATEWAY_TLS_KEY_FILE=/run/secrets/guest-credential-issuer/inference-gateway-client.key
DEVILUDO_GUEST_CREDENTIAL_ISSUER_GATEWAY_TLS_CERT_FILE=/run/secrets/guest-credential-issuer/inference-gateway-client.crt
DEVILUDO_GUEST_CREDENTIAL_ISSUER_GATEWAY_CA_FILE=/run/secrets/guest-credential-issuer/inference-gateway-ca.crt
DEVILUDO_GUEST_CREDENTIAL_ISSUER_EPHEMERAL_SECRET_TLS_KEY_FILE=/run/secrets/guest-credential-issuer/ephemeral-secret-client.key
DEVILUDO_GUEST_CREDENTIAL_ISSUER_EPHEMERAL_SECRET_TLS_CERT_FILE=/run/secrets/guest-credential-issuer/ephemeral-secret-client.crt
DEVILUDO_GUEST_CREDENTIAL_ISSUER_EPHEMERAL_SECRET_CA_FILE=/run/secrets/guest-credential-issuer/ephemeral-secret-ca.crt
DEVILUDO_GUEST_CREDENTIAL_ISSUER_EPHEMERAL_SECRET_BROKER_URL=https://ephemeral-secrets.internal/

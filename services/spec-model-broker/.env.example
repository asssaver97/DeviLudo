NODE_ENV=production
DATABASE_URL=postgresql://deviludo-spec-model@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_SPEC_MODEL_HOST=0.0.0.0
DEVILUDO_SPEC_MODEL_PORT=4773
DEVILUDO_SPEC_MODEL_TLS_KEY_FILE=/run/secrets/spec-model/server.key
DEVILUDO_SPEC_MODEL_TLS_CERT_FILE=/run/secrets/spec-model/server.crt
DEVILUDO_SPEC_MODEL_CLIENT_CA_FILE=/run/secrets/spec-model/client-ca.crt
DEVILUDO_SPEC_MODEL_CLIENT_SPIFFE_IDS=spiffe://deviludo.internal/control/spec-dialogue,spiffe://deviludo.internal/control/user-acceptance

# Exact immutable ACTIVE platform Profile. The Broker always uses its
# smallFastModel and rejects tenant/project Profiles.
DEVILUDO_SPEC_MODEL_PROFILE_REVISION_ID=profile-spec-dialogue-r1

DEVILUDO_SPEC_MODEL_SECRET_BROKER_URL=https://secret-broker.internal/v1/spec-model-credentials/resolve
DEVILUDO_SPEC_MODEL_SECRET_BROKER_TLS_KEY_FILE=/run/secrets/spec-model/secret-broker-client.key
DEVILUDO_SPEC_MODEL_SECRET_BROKER_TLS_CERT_FILE=/run/secrets/spec-model/secret-broker-client.crt
DEVILUDO_SPEC_MODEL_SECRET_BROKER_CA_FILE=/run/secrets/spec-model/secret-broker-ca.crt
DEVILUDO_SPEC_MODEL_SECRET_BROKER_TIMEOUT_MS=10000

DEVILUDO_SPEC_MODEL_UPSTREAM_TIMEOUT_MS=120000
DEVILUDO_SPEC_MODEL_OPERATION_LEASE_SECONDS=180
DEVILUDO_SPEC_MODEL_REQUEST_TIMEOUT_MS=130000

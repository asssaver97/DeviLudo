NODE_ENV=production
DATABASE_URL=postgresql://deviludo@postgres.internal/deviludo
# Optional DEVILUDO_POSTGRES_TLS_CA contains the trusted PostgreSQL PEM CA bundle.

DEVILUDO_STEAM_DEPOT_FINALIZER_HOST=0.0.0.0
DEVILUDO_STEAM_DEPOT_FINALIZER_PORT=4855
DEVILUDO_STEAM_DEPOT_FINALIZER_PLATFORM=linux
DEVILUDO_STEAM_DEPOT_FINALIZER_MAX_BODY_BYTES=65536
DEVILUDO_STEAM_DEPOT_FINALIZER_VERSION=1.0.0
DEVILUDO_STEAM_DEPOT_FINALIZER_BINARY_DIGEST=replace_with_64_character_lowercase_sha256_hex
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_ARTIFACT_FILE=/opt/deviludo/bin/deviludo-steam-depot-finalizer-service.mjs
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_BUILD_RECEIPT_FILE=/opt/deviludo/release/steam-depot-finalizer-service-build-receipt.json
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_BUILD_RECEIPT_DIGEST=replace_with_64_character_lowercase_sha256_hex
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_RELEASE_FILE=/opt/deviludo/release/steam-depot-finalizer-service-release.json
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_TRUST_POLICY_FILE=/etc/deviludo/steam-depot-finalizer-service-trust-policy.json
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_TRUST_POLICY_DIGEST=replace_with_64_character_lowercase_sha256_hex
# Offline release finalization only; never mount these credentials on the runtime host.
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_SIGNER_ENDPOINT=https://release-kms.internal/
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_SIGNING_KEY_ID=steam-depot-finalizer-service-release-key-2026-01
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_SIGNER_TLS_KEY_FILE=/run/secrets/release-signer-client.key
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_SIGNER_TLS_CERT_FILE=/run/secrets/release-signer-client.crt
DEVILUDO_STEAM_DEPOT_FINALIZER_SERVICE_SIGNER_TLS_CA_FILE=/run/secrets/release-signer-ca.crt
DEVILUDO_STEAM_DEPOT_FINALIZER_ALLOWED_SPIFFE_IDS=["spiffe://deviludo.internal/steam-workflow-executor"]
DEVILUDO_STEAM_DEPOT_FINALIZER_TLS_KEY_FILE=/run/secrets/steam-depot-finalizer-server.key
DEVILUDO_STEAM_DEPOT_FINALIZER_TLS_CERT_FILE=/run/secrets/steam-depot-finalizer-server.crt
DEVILUDO_STEAM_DEPOT_FINALIZER_CLIENT_CA_FILE=/run/secrets/workload-ca.crt

# The digest-pinned controller is the only process allowed to use the native
# certificate store, Apple notary identity or Sigstore workload identity.
DEVILUDO_STEAM_DEPOT_FINALIZER_NATIVE_EXECUTABLE=/opt/deviludo/bin/steam-depot-finalizer-native
DEVILUDO_STEAM_DEPOT_FINALIZER_NATIVE_EXECUTABLE_DIGEST=replace_with_64_character_lowercase_sha256_hex
DEVILUDO_STEAM_DEPOT_FINALIZER_NATIVE_POLICY_FILE=/etc/deviludo/steam-depot-finalizer-policy.json
DEVILUDO_STEAM_DEPOT_FINALIZER_NATIVE_POLICY_DIGEST=replace_with_64_character_lowercase_sha256_hex
DEVILUDO_STEAM_DEPOT_FINALIZER_WORK_ROOT=/var/lib/deviludo/steam-depot-finalizer
DEVILUDO_STEAM_DEPOT_FINALIZER_NATIVE_TIMEOUT_MS=3000000
DEVILUDO_STEAM_DEPOT_FINALIZER_LEASE_MS=3300000
DEVILUDO_STEAM_DEPOT_FINALIZER_REQUEST_TIMEOUT_MS=3600000

NODE_ENV=production
DATABASE_URL=postgresql://deviludo@postgres.internal:5432/deviludo
DEVILUDO_DATABASE_SSL_CA_FILE=/run/secrets/postgres/ca.crt
DEVILUDO_DATABASE_SSL_CERT_FILE=/run/secrets/postgres/tls.crt
DEVILUDO_DATABASE_SSL_KEY_FILE=/run/secrets/postgres/tls.key
DEVILUDO_STEAM_APPROVAL_HOST=0.0.0.0
DEVILUDO_STEAM_APPROVAL_PORT=4550
DEVILUDO_STEAM_APPROVAL_TLS_KEY_FILE=/run/secrets/steam-approval/tls.key
DEVILUDO_STEAM_APPROVAL_TLS_CERT_FILE=/run/secrets/steam-approval/tls.crt
DEVILUDO_STEAM_APPROVAL_CLIENT_CA_FILE=/run/secrets/steam-approval/client-ca.crt
DEVILUDO_STEAM_APPROVAL_VERIFIER_SPIFFE_IDS_JSON=["spiffe://deviludo.internal/connector/steam-approval-verifier"]
DEVILUDO_STEAM_APPROVAL_MAX_AGE_SECONDS=900
DEVILUDO_STEAM_APPROVAL_FUTURE_SKEW_SECONDS=60

DEVILUDO_STEAM_CONNECTOR_PLATFORM=linux
DEVILUDO_STEAM_CONNECTOR_RUNNER_ID=runner-linux-1
DEVILUDO_STEAM_CONNECTOR_JOB_KEY_ID=runner-job-key-01
DEVILUDO_STEAM_CONNECTOR_JOB_PUBLIC_KEY_FILE=/run/secrets/deviludo/runner-job-public.pem
DEVILUDO_STEAM_CONNECTOR_TLS_KEY_FILE=/run/secrets/deviludo/steam-connector.key
DEVILUDO_STEAM_CONNECTOR_TLS_CERT_FILE=/run/secrets/deviludo/steam-connector.crt
DEVILUDO_STEAM_CONNECTOR_TLS_CA_FILE=/run/secrets/deviludo/ca.crt
DEVILUDO_STEAM_CONNECTOR_ALLOWED_SPIFFE_IDS=spiffe://deviludo.internal/testkit/runner-linux-1
DEVILUDO_STEAM_CONNECTOR_NATIVE_EXECUTABLE=/opt/deviludo/bin/steam-client-bridge
DEVILUDO_STEAM_CONNECTOR_NATIVE_EXECUTABLE_DIGEST=replace-with-sha256
DEVILUDO_STEAM_CONNECTOR_STAGING_ROOT=/var/lib/deviludo/steam-installs
DEVILUDO_STEAM_CONNECTOR_WORK_ROOT=/var/lib/deviludo/steam-connector
DEVILUDO_STEAM_CONNECTOR_EXECUTION_TIMEOUT_SECONDS=3000
DEVILUDO_STEAM_CONNECTOR_REQUEST_TIMEOUT_SECONDS=3300
DEVILUDO_STEAM_CONNECTOR_HOST=0.0.0.0
DEVILUDO_STEAM_CONNECTOR_PORT=4843

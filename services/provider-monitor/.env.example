NODE_ENV=production
DATABASE_URL=postgresql://deviludo@postgres.internal:5432/deviludo
DEVILUDO_DATABASE_SSL_CA_FILE=/run/secrets/postgres/ca.crt
DEVILUDO_DATABASE_SSL_CERT_FILE=/run/secrets/postgres/tls.crt
DEVILUDO_DATABASE_SSL_KEY_FILE=/run/secrets/postgres/tls.key
DEVILUDO_PROVIDER_MONITOR_HOST=0.0.0.0
DEVILUDO_PROVIDER_MONITOR_PORT=4551
DEVILUDO_PROVIDER_MONITOR_TLS_KEY_FILE=/run/secrets/provider-monitor/tls.key
DEVILUDO_PROVIDER_MONITOR_TLS_CERT_FILE=/run/secrets/provider-monitor/tls.crt
DEVILUDO_PROVIDER_MONITOR_CLIENT_CA_FILE=/run/secrets/provider-monitor/client-ca.crt
DEVILUDO_PROVIDER_MONITOR_SCHEDULER_SPIFFE_IDS_JSON=["spiffe://deviludo.internal/scheduler/provider-recovery"]
DEVILUDO_PROVIDER_MONITOR_WORKER_SPIFFE_ID=spiffe://deviludo.internal/scheduler/provider-recovery
DEVILUDO_PROVIDER_MONITOR_POLL_INTERVAL_MS=1000
DEVILUDO_PROVIDER_MONITOR_BATCH_SIZE=20
DEVILUDO_WORKLOAD_ID=provider-monitor-prod-a
DEVILUDO_WORKFLOW_ASSIGNMENT_MANIFEST_FILE=/run/assignments/provider-monitor-tenants.json
DEVILUDO_WORKFLOW_ASSIGNMENT_KEY_ID=workflow-assignments-key-01
DEVILUDO_WORKFLOW_ASSIGNMENT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
DEVILUDO_PROVIDER_MONITOR_INFERENCE_PROBE_URL=https://inference-gateway.internal/v1/provider-probes
DEVILUDO_PROVIDER_MONITOR_INFERENCE_TLS_KEY_FILE=/run/secrets/provider-monitor/inference.key
DEVILUDO_PROVIDER_MONITOR_INFERENCE_TLS_CERT_FILE=/run/secrets/provider-monitor/inference.crt
DEVILUDO_PROVIDER_MONITOR_INFERENCE_CA_FILE=/run/secrets/provider-monitor/inference-ca.crt

NODE_ENV=production

DEVILUDO_EVIDENCE_ARCHIVE_HOST=0.0.0.0
DEVILUDO_EVIDENCE_ARCHIVE_PORT=4443

# Dedicated server certificate; only the isolated Runner ingress CA is trusted.
DEVILUDO_EVIDENCE_ARCHIVE_TLS_KEY_FILE=/run/secrets/evidence-archive/tls.key
DEVILUDO_EVIDENCE_ARCHIVE_TLS_CERT_FILE=/run/secrets/evidence-archive/tls.crt
DEVILUDO_EVIDENCE_ARCHIVE_CLIENT_CA_FILE=/run/secrets/evidence-archive/runner-ingress-ca.crt
DEVILUDO_EVIDENCE_ARCHIVE_ALLOWED_SPIFFE_IDS_JSON=["spiffe://deviludo.internal/runner-control/ingress"]

# Production accepts only a fixed HTTPS S3-compatible endpoint. Credentials
# are mounted files and never appear in process arguments or ordinary env vars.
DEVILUDO_EVIDENCE_ARCHIVE_STORE=s3
DEVILUDO_EVIDENCE_ARCHIVE_S3_ENDPOINT=https://minio.internal:9000
DEVILUDO_EVIDENCE_ARCHIVE_S3_BUCKET=deviludo-evidence
DEVILUDO_EVIDENCE_ARCHIVE_S3_REGION=us-east-1
DEVILUDO_EVIDENCE_ARCHIVE_S3_ACCESS_KEY_FILE=/run/secrets/evidence-archive/s3-access-key
DEVILUDO_EVIDENCE_ARCHIVE_S3_SECRET_KEY_FILE=/run/secrets/evidence-archive/s3-secret-key
DEVILUDO_EVIDENCE_ARCHIVE_S3_CA_FILE=/run/secrets/evidence-archive/s3-ca.crt
DEVILUDO_EVIDENCE_ARCHIVE_S3_TIMEOUT_SECONDS=30

# Non-production integration alternative only:
# DEVILUDO_EVIDENCE_ARCHIVE_STORE=filesystem
# DEVILUDO_EVIDENCE_ARCHIVE_FILESYSTEM_ROOT=/absolute/path/to/.deviludo/evidence-objects

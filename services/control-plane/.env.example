DEVILUDO_CONTROL_PLANE_HOST=0.0.0.0
DEVILUDO_CONTROL_PLANE_PORT=4100
# Inject from Vault; at least 32 random bytes encoded as standard base64.
DEVILUDO_ADMIN_SESSION_HMAC_KEY=
DATABASE_URL=postgresql://deviludo@postgres.internal/deviludo
# Optional PEM CA bundle for a private PostgreSQL issuer.
DEVILUDO_POSTGRES_TLS_CA=
DEVILUDO_INFERENCE_PROBE_URL=https://inference-gateway.internal/v1/provider-probes
DEVILUDO_INFERENCE_PROBE_TLS_KEY_FILE=/run/secrets/inference-probe-client.key
DEVILUDO_INFERENCE_PROBE_TLS_CERT_FILE=/run/secrets/inference-probe-client.crt
DEVILUDO_INFERENCE_PROBE_CA_FILE=/run/secrets/inference-gateway-ca.crt
DEVILUDO_INFERENCE_RECONCILIATION_URL=https://inference-gateway.internal/v1/inference-reconciliations
DEVILUDO_INFERENCE_RECONCILIATION_TLS_KEY_FILE=/run/secrets/inference-reconciliation-client.key
DEVILUDO_INFERENCE_RECONCILIATION_TLS_CERT_FILE=/run/secrets/inference-reconciliation-client.crt
DEVILUDO_INFERENCE_RECONCILIATION_CA_FILE=/run/secrets/inference-gateway-ca.crt
DEVILUDO_SPEC_MODEL_RECONCILIATION_URL=https://spec-model-broker.internal/v1/spec-generation-reconciliations
DEVILUDO_SPEC_MODEL_RECONCILIATION_TLS_KEY_FILE=/run/secrets/spec-model-reconciliation-client.key
DEVILUDO_SPEC_MODEL_RECONCILIATION_TLS_CERT_FILE=/run/secrets/spec-model-reconciliation-client.crt
DEVILUDO_SPEC_MODEL_RECONCILIATION_CA_FILE=/run/secrets/spec-model-broker-ca.crt
DEVILUDO_VAULT_INGRESS_URL=https://secret-broker.internal
DEVILUDO_VAULT_INGRESS_TLS_KEY_FILE=/run/secrets/secret-broker-client.key
DEVILUDO_VAULT_INGRESS_TLS_CERT_FILE=/run/secrets/secret-broker-client.crt
DEVILUDO_VAULT_INGRESS_CA_FILE=/run/secrets/secret-broker-ca.crt

# Production-only isolated Agent supply-chain Broker. TLS material must be
# mounted as files; never place PEM contents or package registry credentials in env.
DEVILUDO_AGENT_SUPPLY_CHAIN_URL=https://agent-supply-chain.internal
DEVILUDO_AGENT_SUPPLY_CHAIN_TLS_KEY_FILE=/run/secrets/agent-supply-chain-client.key
DEVILUDO_AGENT_SUPPLY_CHAIN_TLS_CERT_FILE=/run/secrets/agent-supply-chain-client.crt
DEVILUDO_AGENT_SUPPLY_CHAIN_CA_FILE=/run/secrets/agent-supply-chain-ca.crt
DEVILUDO_AGENT_SUPPLY_CHAIN_VERSION=1.0.0
# Exact 64-character lowercase SHA-256 hex from the signed Broker manifest.
DEVILUDO_AGENT_SUPPLY_CHAIN_BINARY_DIGEST=replace_with_64_character_lowercase_sha256_hex
DEVILUDO_AGENT_SUPPLY_CHAIN_TIMEOUT_SECONDS=600

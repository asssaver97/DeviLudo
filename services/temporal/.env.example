TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
DEVILUDO_TEMPORAL_TASK_QUEUE=deviludo-game-delivery-v1
DEVILUDO_CONTROL_PLANE_DISPATCH_URL=https://control-plane.internal/v1/workflow-commands
DEVILUDO_AGENT_WORKER_DISPATCH_URL=https://agent-worker.internal/v1/workflow-commands
DEVILUDO_RUNNER_CONTROL_DISPATCH_URL=https://runner-control.internal/v1/workflow-commands
DEVILUDO_SCM_PROXY_DISPATCH_URL=https://scm-proxy.internal/v1/workflow-commands
DEVILUDO_STEAM_PUBLISHER_DISPATCH_URL=https://steam-publisher.internal/v1/workflow-commands
# Read-only Temporal workload certificate used for direct mTLS dispatch.
DEVILUDO_TEMPORAL_DISPATCH_TLS_KEY_FILE=/run/secrets/temporal-dispatch/tls.key
DEVILUDO_TEMPORAL_DISPATCH_TLS_CERT_FILE=/run/secrets/temporal-dispatch/tls.crt
DEVILUDO_TEMPORAL_DISPATCH_CA_FILE=/run/secrets/temporal-dispatch/ca.crt
DEVILUDO_MAX_CONCURRENT_ACTIVITIES=100
DEVILUDO_MAX_CONCURRENT_WORKFLOWS=100

# Destination service settings. Each process has one fixed destination and a
# distinct workload certificate/assignment manifest.
DATABASE_URL=postgresql://deviludo@postgres.internal/deviludo
DEVILUDO_POSTGRES_TLS_CA=
DEVILUDO_WORKFLOW_SERVICE_HOST=0.0.0.0
DEVILUDO_WORKFLOW_SERVICE_PORT=4200
DEVILUDO_WORKLOAD_ID=control-plane-workflow-pool-01
DEVILUDO_WORKFLOW_TLS_KEY_FILE=/run/secrets/control-plane-workflow/tls.key
DEVILUDO_WORKFLOW_TLS_CERT_FILE=/run/secrets/control-plane-workflow/tls.crt
DEVILUDO_WORKFLOW_CLIENT_CA_FILE=/run/secrets/control-plane-workflow/temporal-ca.crt
DEVILUDO_TEMPORAL_DISPATCHER_SPIFFE_IDS=spiffe://deviludo.internal/control/temporal-worker
DEVILUDO_WORKFLOW_ASSIGNMENT_MANIFEST_FILE=/run/assignments/control-plane.json
DEVILUDO_WORKFLOW_ASSIGNMENT_KEY_ID=workflow-assignment-key-01
# Ed25519 public PEM; the signing key remains in the control plane/KMS.
DEVILUDO_WORKFLOW_ASSIGNMENT_PUBLIC_KEY=

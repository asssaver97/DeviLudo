TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
DEVILUDO_TEMPORAL_TASK_QUEUE=deviludo-game-delivery-v1
# Temporal cluster mTLS (used by Worker, destination services and CLI client).
DEVILUDO_TEMPORAL_TLS_CA_FILE=/run/secrets/temporal-cluster/ca.crt
DEVILUDO_TEMPORAL_TLS_CERT_FILE=/run/secrets/temporal-cluster/tls.crt
DEVILUDO_TEMPORAL_TLS_KEY_FILE=/run/secrets/temporal-cluster/tls.key
DEVILUDO_TEMPORAL_TLS_SERVER_NAME=temporal.internal
DEVILUDO_CONTROL_PLANE_DISPATCH_URL=https://control-plane.internal/v1/workflow-commands
DEVILUDO_AGENT_WORKER_DISPATCH_URL=https://agent-worker.internal/v1/workflow-commands
DEVILUDO_RUNNER_CONTROL_DISPATCH_URL=https://runner-control.internal/v1/workflow-commands
DEVILUDO_SCM_PROXY_DISPATCH_URL=https://scm-proxy.internal/v1/workflow-commands
DEVILUDO_STEAM_PUBLISHER_DISPATCH_URL=https://steam-publisher.internal/v1/workflow-commands
# Every deterministic transition, including initial and terminal state, is
# persisted through this separate replay-validating mTLS projection service.
DEVILUDO_DELIVERY_PROJECTION_URL=https://delivery-projection.internal/v1/delivery-projections
# Read-only Temporal workload certificate used for direct mTLS dispatch.
DEVILUDO_TEMPORAL_DISPATCH_TLS_KEY_FILE=/run/secrets/temporal-dispatch/tls.key
DEVILUDO_TEMPORAL_DISPATCH_TLS_CERT_FILE=/run/secrets/temporal-dispatch/tls.crt
DEVILUDO_TEMPORAL_DISPATCH_CA_FILE=/run/secrets/temporal-dispatch/ca.crt
DEVILUDO_MAX_CONCURRENT_ACTIVITIES=100
DEVILUDO_MAX_CONCURRENT_WORKFLOWS=100

# Destination service settings. Each process has one fixed destination and a
# distinct workload certificate/assignment manifest.
DATABASE_URL=postgresql://deviludo@postgres.internal/deviludo
DEVILUDO_POSTGRES_TLS_CA=
DEVILUDO_WORKFLOW_SERVICE_HOST=0.0.0.0
DEVILUDO_WORKFLOW_SERVICE_PORT=4200
DEVILUDO_WORKLOAD_ID=control-plane-workflow-pool-01
DEVILUDO_WORKFLOW_TLS_KEY_FILE=/run/secrets/control-plane-workflow/tls.key
DEVILUDO_WORKFLOW_TLS_CERT_FILE=/run/secrets/control-plane-workflow/tls.crt
DEVILUDO_WORKFLOW_CLIENT_CA_FILE=/run/secrets/control-plane-workflow/temporal-ca.crt
DEVILUDO_TEMPORAL_DISPATCHER_SPIFFE_IDS=spiffe://deviludo.internal/control/temporal-worker
# JSON object mapping each authoritative completion workload identity to its
# one fixed role. This is required by the control-plane workflow destination.
DEVILUDO_WORKFLOW_COMPLETION_SPIFFE_SOURCES_JSON={"spiffe://deviludo.internal/service/spec":"SPEC_SERVICE","spiffe://deviludo.internal/service/agent-configuration":"AGENT_CONFIGURATION_SERVICE","spiffe://deviludo.internal/service/user-acceptance":"USER_ACCEPTANCE_SERVICE","spiffe://deviludo.internal/monitor/provider":"PROVIDER_MONITOR","spiffe://deviludo.internal/broker/mfa":"MFA_BROKER","spiffe://deviludo.internal/monitor/steam-approval":"STEAM_APPROVAL_MONITOR"}
DEVILUDO_WORKFLOW_ASSIGNMENT_MANIFEST_FILE=/run/assignments/control-plane.json
DEVILUDO_WORKFLOW_ASSIGNMENT_KEY_ID=workflow-assignment-key-01
# Ed25519 public PEM; the signing key remains in the control plane/KMS.
DEVILUDO_WORKFLOW_ASSIGNMENT_PUBLIC_KEY=

# Agent destination only. The destination host dispatches into an isolated
# microVM Broker and never installs Claude Code or Codex CLI itself.
DEVILUDO_AGENT_EXECUTION_BROKER_URL=https://agent-execution-broker.internal/v1/agent-runs
DEVILUDO_AGENT_EXECUTION_BROKER_TLS_KEY_FILE=/run/secrets/agent-execution-broker-client/tls.key
DEVILUDO_AGENT_EXECUTION_BROKER_TLS_CERT_FILE=/run/secrets/agent-execution-broker-client/tls.crt
DEVILUDO_AGENT_EXECUTION_BROKER_CA_FILE=/run/secrets/agent-execution-broker-client/ca.crt
DEVILUDO_AGENT_EXECUTION_REQUEST_TIMEOUT_SECONDS=30
DEVILUDO_AGENT_EXECUTION_POLL_SECONDS=5
DEVILUDO_AGENT_EXECUTION_MAX_WAIT_SECONDS=7200

# Runner workflow destination only. Physical Runner ingress updates the
# durable attempt asynchronously; this service only waits for bound evidence.
DEVILUDO_RUNNER_ATTEMPT_POLL_SECONDS=5
DEVILUDO_RUNNER_ATTEMPT_MAX_WAIT_SECONDS=7200

# SCM workflow destination only. GitHub App credentials remain inside this
# isolated, workload-authenticated Broker.
DEVILUDO_SCM_MERGE_BROKER_URL=https://scm-merge-broker.internal/v1/merges
DEVILUDO_SCM_MERGE_BROKER_TLS_KEY_FILE=/run/secrets/scm-merge-broker-client/tls.key
DEVILUDO_SCM_MERGE_BROKER_TLS_CERT_FILE=/run/secrets/scm-merge-broker-client/tls.crt
DEVILUDO_SCM_MERGE_BROKER_CA_FILE=/run/secrets/scm-merge-broker-client/ca.crt
DEVILUDO_SCM_MERGE_REQUEST_TIMEOUT_SECONDS=30
DEVILUDO_SCM_MERGE_POLL_SECONDS=5
DEVILUDO_SCM_MERGE_MAX_WAIT_SECONDS=1800

# Steam workflow destination only. No password, Guard code or config.vdf is
# mounted into the Temporal destination process.
DEVILUDO_STEAM_WORKFLOW_BROKER_URL=https://steam-workflow-broker.internal/v1/steam-operations
DEVILUDO_STEAM_WORKFLOW_BROKER_VERSION=1.0.0
DEVILUDO_STEAM_WORKFLOW_BROKER_BINARY_DIGEST=<64-lowercase-hex>
DEVILUDO_STEAM_WORKFLOW_BROKER_TLS_KEY_FILE=/run/secrets/steam-workflow-broker-client/tls.key
DEVILUDO_STEAM_WORKFLOW_BROKER_TLS_CERT_FILE=/run/secrets/steam-workflow-broker-client/tls.crt
DEVILUDO_STEAM_WORKFLOW_BROKER_CA_FILE=/run/secrets/steam-workflow-broker-client/ca.crt
DEVILUDO_STEAM_OPERATION_REQUEST_TIMEOUT_SECONDS=30
DEVILUDO_STEAM_OPERATION_POLL_SECONDS=10
DEVILUDO_STEAM_OPERATION_MAX_WAIT_SECONDS=7200

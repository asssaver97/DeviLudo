NODE_ENV=production
DEVILUDO_INFERENCE_GATEWAY_HOST=0.0.0.0
DEVILUDO_INFERENCE_GATEWAY_PORT=4743
DEVILUDO_INFERENCE_GATEWAY_TLS_KEY_FILE=/run/secrets/inference-gateway-server.key
DEVILUDO_INFERENCE_GATEWAY_TLS_CERT_FILE=/run/secrets/inference-gateway-server.crt
DEVILUDO_INFERENCE_GATEWAY_CLIENT_CA_FILE=/run/secrets/inference-gateway-client-ca.crt
DEVILUDO_INFERENCE_GATEWAY_PROBE_SPIFFE_IDS=["spiffe://deviludo.internal/control-plane"]
# Raw 32-128 byte random HMAC key mounted by the secret manager.
DEVILUDO_INFERENCE_GATEWAY_RUN_TOKEN_KEY_FILE=/run/secrets/inference-gateway-run-token.key

DATABASE_URL=postgresql://deviludo@postgres.internal/deviludo
DEVILUDO_POSTGRES_TLS_CA=
DEVILUDO_WORKFLOW_POSTGRES_POOL_SIZE=10

DEVILUDO_INFERENCE_CREDENTIAL_BROKER_URL=https://inference-credential-broker.internal/v1/inference-credentials/resolve
DEVILUDO_INFERENCE_CREDENTIAL_BROKER_TLS_KEY_FILE=/run/secrets/inference-credential-broker-client.key
DEVILUDO_INFERENCE_CREDENTIAL_BROKER_TLS_CERT_FILE=/run/secrets/inference-credential-broker-client.crt
DEVILUDO_INFERENCE_CREDENTIAL_BROKER_CA_FILE=/run/secrets/inference-credential-broker-ca.crt
DEVILUDO_INFERENCE_CREDENTIAL_BROKER_TIMEOUT_SECONDS=10

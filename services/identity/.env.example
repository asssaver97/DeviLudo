NODE_ENV=production
DATABASE_URL=postgresql://deviludo-identity@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_IDENTITY_HOST=0.0.0.0
DEVILUDO_IDENTITY_PORT=4560
DEVILUDO_IDENTITY_REQUEST_TIMEOUT_MS=30000
DEVILUDO_IDENTITY_SESSION_SECONDS=28800
DEVILUDO_IDENTITY_WEB_SPIFFE_IDS=spiffe://deviludo.internal/web
DEVILUDO_IDENTITY_ADMIN_SPIFFE_IDS=spiffe://deviludo.internal/identity-admin
DEVILUDO_IDENTITY_TLS_KEY_FILE=/run/secrets/identity-server.key
DEVILUDO_IDENTITY_TLS_CERT_FILE=/run/secrets/identity-server.crt
DEVILUDO_IDENTITY_CLIENT_CA_FILE=/run/secrets/workload-ca.crt

DEVILUDO_IDENTITY_SECRET_BROKER_URL=https://secret-broker.internal/
DEVILUDO_IDENTITY_SECRET_TLS_KEY_FILE=/run/secrets/secret-broker-client.key
DEVILUDO_IDENTITY_SECRET_TLS_CERT_FILE=/run/secrets/secret-broker-client.crt
DEVILUDO_IDENTITY_SECRET_CA_FILE=/run/secrets/secret-broker-ca.crt
DEVILUDO_IDENTITY_SECRET_TIMEOUT_MS=10000

DEVILUDO_GITHUB_APP_CLIENT_ID=Iv1.replace-with-public-client-id
DEVILUDO_GITHUB_APP_CLIENT_SECRET_REF=vault://kv/github/app-client-secret
DEVILUDO_IDENTITY_GITHUB_REDIRECT_URI=https://deviludo.example/api/auth/github/callback
DEVILUDO_GITHUB_API_TIMEOUT_MS=15000
# Inject 32-64 random bytes as base64url from Vault/KMS; never commit material.
DEVILUDO_SESSION_HMAC_KEY=

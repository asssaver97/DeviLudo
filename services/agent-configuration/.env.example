NODE_ENV=production

DATABASE_URL=postgresql://deviludo-agent-configuration@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Signed tenant assignment manifest used by the control-plane destination.
DEVILUDO_WORKFLOW_ASSIGNMENT_MANIFEST_FILE=/run/assignments/control-plane-tenants.json
DEVILUDO_WORKFLOW_ASSIGNMENT_KEY_ID=workflow-assignments-key-01
DEVILUDO_WORKFLOW_ASSIGNMENT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
DEVILUDO_WORKLOAD_ID=agent-configuration-primary

# Read-only SCM Broker identity. The Agent Configuration process never receives
# a GitHub installation token or App private key.
DEVILUDO_SOURCE_BASELINE_BROKER_URL=https://source-snapshot.internal:4543
DEVILUDO_SOURCE_BASELINE_TLS_KEY_FILE=/run/secrets/agent-configuration/source-baseline-client.key
DEVILUDO_SOURCE_BASELINE_TLS_CERT_FILE=/run/secrets/agent-configuration/source-baseline-client.crt
DEVILUDO_SOURCE_BASELINE_CA_FILE=/run/secrets/agent-configuration/source-baseline-ca.crt
DEVILUDO_SOURCE_BASELINE_TIMEOUT_SECONDS=60
DEVILUDO_AGENT_CONFIGURATION_POLL_INTERVAL_MS=1000

NODE_ENV=production
DATABASE_URL=postgresql://deviludo:replace-me@postgres.internal:5432/deviludo
TEMPORAL_ADDRESS=temporal.internal:7233
TEMPORAL_NAMESPACE=deviludo
DEVILUDO_WORKLOAD_ID=spec-workflow-bridge-primary
DEVILUDO_SPEC_WORKFLOW_HOST=0.0.0.0
DEVILUDO_SPEC_WORKFLOW_PORT=4555
DEVILUDO_SPEC_WORKFLOW_POLL_INTERVAL_MS=1000
DEVILUDO_SPEC_WORKFLOW_TLS_KEY_FILE=/run/secrets/spec-workflow/tls.key
DEVILUDO_SPEC_WORKFLOW_TLS_CERT_FILE=/run/secrets/spec-workflow/tls.crt
DEVILUDO_SPEC_WORKFLOW_CLIENT_CA_FILE=/run/secrets/spec-workflow/client-ca.pem

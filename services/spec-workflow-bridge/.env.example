DEVILUDO_WORKFLOW_ASSIGNMENT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----replace-me-----END PUBLIC KEY-----
DEVILUDO_TEMPORAL_TLS_CA_FILE=/run/secrets/temporal/ca.pem

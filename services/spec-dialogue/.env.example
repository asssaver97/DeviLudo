DATABASE_URL=postgresql://deviludo_app:change-me@postgres.internal/deviludo
DEVILUDO_POSTGRES_TLS_CA=/run/secrets/postgres-ca.pem
DEVILUDO_SPEC_DIALOGUE_HOST=0.0.0.0
DEVILUDO_SPEC_DIALOGUE_PORT=4544
DEVILUDO_SPEC_DIALOGUE_TLS_KEY_FILE=/run/secrets/spec-dialogue-server.key
DEVILUDO_SPEC_DIALOGUE_TLS_CERT_FILE=/run/secrets/spec-dialogue-server.crt
DEVILUDO_SPEC_DIALOGUE_CLIENT_CA_FILE=/run/secrets/workload-ca.pem
DEVILUDO_SPEC_DIALOGUE_WEB_SPIFFE_IDS=spiffe://deviludo.internal/web
DEVILUDO_SPEC_MODEL_BROKER_URL=https://spec-model-broker.internal/v1/spec-generations
DEVILUDO_SPEC_MODEL_BROKER_TLS_KEY_FILE=/run/secrets/spec-dialogue-client.key
DEVILUDO_SPEC_MODEL_BROKER_TLS_CERT_FILE=/run/secrets/spec-dialogue-client.crt
DEVILUDO_SPEC_MODEL_BROKER_CA_FILE=/run/secrets/spec-model-broker-ca.pem
DEVILUDO_SPEC_MODEL_BROKER_TIMEOUT_SECONDS=30

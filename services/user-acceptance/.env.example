NODE_ENV=production

DATABASE_URL=postgresql://deviludo-user-acceptance@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_USER_ACCEPTANCE_HOST=0.0.0.0
DEVILUDO_USER_ACCEPTANCE_PORT=4547
DEVILUDO_USER_ACCEPTANCE_WEB_SPIFFE_IDS=spiffe://deviludo.internal/web
DEVILUDO_USER_ACCEPTANCE_TLS_KEY_FILE=/run/secrets/user-acceptance/server.key
DEVILUDO_USER_ACCEPTANCE_TLS_CERT_FILE=/run/secrets/user-acceptance/server.crt
DEVILUDO_USER_ACCEPTANCE_CLIENT_CA_FILE=/run/secrets/user-acceptance/web-ca.crt

DEVILUDO_SPEC_MODEL_BROKER_URL=https://spec-model.internal/v1/spec-generations
DEVILUDO_USER_ACCEPTANCE_MODEL_TLS_KEY_FILE=/run/secrets/user-acceptance/model-client.key
DEVILUDO_USER_ACCEPTANCE_MODEL_TLS_CERT_FILE=/run/secrets/user-acceptance/model-client.crt
DEVILUDO_USER_ACCEPTANCE_MODEL_CA_FILE=/run/secrets/user-acceptance/model-ca.crt
DEVILUDO_USER_ACCEPTANCE_MODEL_TIMEOUT_SECONDS=120

NODE_ENV=production

DATABASE_URL=postgresql://deviludo-delivery-projection@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_DELIVERY_PROJECTION_HOST=0.0.0.0
DEVILUDO_DELIVERY_PROJECTION_PORT=4557
DEVILUDO_DELIVERY_PROJECTION_TLS_KEY_FILE=/run/secrets/delivery-projection/server.key
DEVILUDO_DELIVERY_PROJECTION_TLS_CERT_FILE=/run/secrets/delivery-projection/server.crt
DEVILUDO_DELIVERY_PROJECTION_CLIENT_CA_FILE=/run/secrets/delivery-projection/client-ca.crt

# Write and read identities must be disjoint. Temporal is the sole writer;
# the Web service can only read within the tenant from its signed user session.
DEVILUDO_DELIVERY_PROJECTION_TEMPORAL_SPIFFE_IDS=spiffe://deviludo.internal/control/temporal-worker
DEVILUDO_DELIVERY_PROJECTION_WEB_SPIFFE_IDS=spiffe://deviludo.internal/web

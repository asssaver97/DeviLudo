{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "incremental": false,
    "baseUrl": "../..",
    "paths": { "@/*": ["./*"] },
    "allowJs": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}

NODE_ENV=production

# Dedicated TLS 1.3 listener. Only the Runner Control workflow workload is admitted.
DEVILUDO_ARTIFACT_PREPARER_HOST=0.0.0.0
DEVILUDO_ARTIFACT_PREPARER_PORT=4643
DEVILUDO_ARTIFACT_PREPARER_TLS_KEY_FILE=/run/secrets/artifact-preparer/server.key
DEVILUDO_ARTIFACT_PREPARER_TLS_CERT_FILE=/run/secrets/artifact-preparer/server.crt
DEVILUDO_ARTIFACT_PREPARER_CLIENT_CA_FILE=/run/secrets/artifact-preparer/runner-control-ca.crt
DEVILUDO_ARTIFACT_PREPARER_RUNNER_CONTROL_SPIFFE_ID=spiffe://deviludo.internal/runner-control/artifact-preparer
DEVILUDO_ARTIFACT_PREPARER_REQUEST_TIMEOUT_SECONDS=86400
DEVILUDO_ARTIFACT_PREPARER_WORK_ROOT=/var/lib/deviludo/artifact-preparer-work

# Atomically replaced, at-most-15-minute tenant assignment bound to the exact
# Runner Control client certificate fingerprint.
DEVILUDO_ARTIFACT_PREPARER_ASSIGNMENT_MANIFEST_FILE=/run/assignments/runner-control-artifact-tenants.json
DEVILUDO_ARTIFACT_PREPARER_ASSIGNMENT_KEY_ID=prepared-input-assignments-key-01
DEVILUDO_ARTIFACT_PREPARER_ASSIGNMENT_PUBLIC_KEY_FILE=/run/secrets/artifact-preparer/assignments-ed25519.pub

DATABASE_URL=postgresql://deviludo-artifact-preparer@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

# Read-only authoritative SCM snapshot Broker client identity.
DEVILUDO_SOURCE_SNAPSHOT_BROKER_URL=https://source-snapshot.internal:4543
DEVILUDO_SOURCE_SNAPSHOT_TLS_KEY_FILE=/run/secrets/artifact-preparer/source-snapshot-client.key
DEVILUDO_SOURCE_SNAPSHOT_TLS_CERT_FILE=/run/secrets/artifact-preparer/source-snapshot-client.crt
DEVILUDO_SOURCE_SNAPSHOT_CA_FILE=/run/secrets/artifact-preparer/source-snapshot-ca.crt
DEVILUDO_SOURCE_SNAPSHOT_TRANSFER_CA_FILE=/run/secrets/artifact-preparer/s3-ca.crt
DEVILUDO_SOURCE_SNAPSHOT_ALLOWED_TRANSFER_ORIGINS_JSON=["https://minio.internal:9000"]
DEVILUDO_SOURCE_SNAPSHOT_REQUEST_TIMEOUT_SECONDS=600
DEVILUDO_SOURCE_SNAPSHOT_TRANSFER_TIMEOUT_SECONDS=7200

# Evidence Archive issues and verifies five-minute immutable input upload grants.
DEVILUDO_PREPARED_INPUT_BROKER_URL=https://evidence-archive.internal:4443
DEVILUDO_PREPARED_INPUT_TLS_KEY_FILE=/run/secrets/artifact-preparer/evidence-archive-client.key
DEVILUDO_PREPARED_INPUT_TLS_CERT_FILE=/run/secrets/artifact-preparer/evidence-archive-client.crt
DEVILUDO_PREPARED_INPUT_CA_FILE=/run/secrets/artifact-preparer/evidence-archive-ca.crt
DEVILUDO_PREPARED_INPUT_TRANSFER_CA_FILE=/run/secrets/artifact-preparer/s3-ca.crt
DEVILUDO_PREPARED_INPUT_ALLOWED_TRANSFER_ORIGINS_JSON=["https://minio.internal:9000"]
DEVILUDO_PREPARED_INPUT_REQUEST_TIMEOUT_SECONDS=30
DEVILUDO_PREPARED_INPUT_TRANSFER_TIMEOUT_SECONDS=7200

NODE_ENV=production
DATABASE_URL=postgresql://deviludo@postgres.internal/deviludo
# Optional DEVILUDO_POSTGRES_TLS_CA contains the trusted PostgreSQL PEM CA bundle.

DEVILUDO_AGENT_SUPPLY_CHAIN_SERVER_HOST=0.0.0.0
DEVILUDO_AGENT_SUPPLY_CHAIN_SERVER_PORT=4755
DEVILUDO_AGENT_SUPPLY_CHAIN_SERVER_MAX_BODY_BYTES=262144
DEVILUDO_AGENT_SUPPLY_CHAIN_SERVER_VERSION=1.0.0
DEVILUDO_AGENT_SUPPLY_CHAIN_SERVER_BINARY_DIGEST=replace_with_64_character_lowercase_sha256_hex
DEVILUDO_AGENT_SUPPLY_CHAIN_SERVER_ALLOWED_SPIFFE_IDS=["spiffe://deviludo.internal/control-plane"]
DEVILUDO_AGENT_SUPPLY_CHAIN_SERVER_TLS_KEY_FILE=/run/secrets/agent-supply-chain-server.key
DEVILUDO_AGENT_SUPPLY_CHAIN_SERVER_TLS_CERT_FILE=/run/secrets/agent-supply-chain-server.crt
DEVILUDO_AGENT_SUPPLY_CHAIN_SERVER_CLIENT_CA_FILE=/run/secrets/workload-ca.crt

# Signed platform artifact and immutable policy/registry manifest. Registry
# credentials remain inside its isolated connector; they never enter requests.
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_EXECUTABLE=/opt/deviludo/bin/agent-supply-chain-native
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_EXECUTABLE_DIGEST=replace_with_64_character_lowercase_sha256_hex
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_PLATFORM_VERSION=0.1.0-beta.1
# The Broker re-verifies the KMS-signed release envelope and its independently
# reviewed Ed25519 policy before it can probe the privileged executable.
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_BUILD_RECEIPT_FILE=/opt/deviludo/release/agent-supply-chain-native-build-receipt.json
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_RELEASE_MANIFEST_FILE=/opt/deviludo/release/agent-supply-chain-native-release.json
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_TRUST_POLICY_FILE=/etc/deviludo/agent-supply-chain-native-trust-policy.json
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_TRUST_POLICY_DIGEST=replace_with_64_character_lowercase_sha256_hex
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_CONFIG_FILE=/etc/deviludo/agent-supply-chain-policy.json
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_CONFIG_DIGEST=replace_with_64_character_lowercase_sha256_hex
DEVILUDO_AGENT_SUPPLY_CHAIN_WORK_ROOT=/var/lib/deviludo/agent-supply-chain
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_TIMEOUT_MS=480000
DEVILUDO_AGENT_SUPPLY_CHAIN_LEASE_MS=600000
DEVILUDO_AGENT_SUPPLY_CHAIN_SERVER_REQUEST_TIMEOUT_MS=600000

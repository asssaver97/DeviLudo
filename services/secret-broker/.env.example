NODE_ENV=production
DATABASE_URL=postgresql://deviludo-secret-broker@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_SECRET_BROKER_HOST=0.0.0.0
DEVILUDO_SECRET_BROKER_PORT=4762
DEVILUDO_SECRET_BROKER_TLS_KEY_FILE=/run/secrets/secret-broker/server.key
DEVILUDO_SECRET_BROKER_TLS_CERT_FILE=/run/secrets/secret-broker/server.crt
DEVILUDO_SECRET_BROKER_CLIENT_CA_FILE=/run/secrets/secret-broker/client-ca.crt
DEVILUDO_SECRET_BROKER_CONTROL_PLANE_SPIFFE_IDS=spiffe://deviludo.internal/control/control-plane
DEVILUDO_SECRET_BROKER_GITHUB_SPIFFE_IDS=spiffe://deviludo.internal/scm/github-authorization,spiffe://deviludo.internal/control/identity
DEVILUDO_SECRET_BROKER_INFERENCE_SPIFFE_IDS=spiffe://deviludo.internal/inference/gateway
# Exact pre-provisioned Vault references; the GitHub/Identity role cannot lease
# any other object under the static namespace.
DEVILUDO_SECRET_BROKER_GITHUB_STATIC_SECRET_REFS=vault://kv/deviludo/static/github-oauth-client-secret

DEVILUDO_SECRET_BROKER_VAULT_URL=https://vault.internal
DEVILUDO_SECRET_BROKER_VAULT_KV_MOUNT=secret
# Short-lived Vault Agent token; never place it directly in an environment variable.
DEVILUDO_SECRET_BROKER_VAULT_TOKEN_FILE=/run/secrets/secret-broker/vault-token
DEVILUDO_SECRET_BROKER_VAULT_CA_FILE=/run/secrets/secret-broker/vault-ca.crt
# Optional Vault mTLS client identity. Configure both or neither.
DEVILUDO_SECRET_BROKER_VAULT_TLS_KEY_FILE=/run/secrets/secret-broker/vault-client.key
DEVILUDO_SECRET_BROKER_VAULT_TLS_CERT_FILE=/run/secrets/secret-broker/vault-client.crt
DEVILUDO_SECRET_BROKER_VAULT_TIMEOUT_MS=10000
DEVILUDO_SECRET_BROKER_REQUEST_TIMEOUT_MS=30000
DEVILUDO_SECRET_BROKER_EXPIRY_SWEEP_MS=60000

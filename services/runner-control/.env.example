NODE_ENV=production
DATABASE_URL=postgresql://deviludo@postgres.internal/deviludo
# Inline PEM CA consumed by node-postgres.
DEVILUDO_POSTGRES_TLS_CA=

# Dedicated physical Runner mTLS listener. This is not a public Web endpoint.
DEVILUDO_RUNNER_INGRESS_HOST=0.0.0.0
DEVILUDO_RUNNER_INGRESS_PORT=4300
DEVILUDO_RUNNER_INGRESS_MAX_BODY_BYTES=1048576
DEVILUDO_RUNNER_INGRESS_TLS_KEY_FILE=/run/secrets/runner-ingress/tls.key
DEVILUDO_RUNNER_INGRESS_TLS_CERT_FILE=/run/secrets/runner-ingress/tls.crt
DEVILUDO_RUNNER_INGRESS_CLIENT_CA_FILE=/run/secrets/runner-ingress/runner-ca.crt

# Ed25519 key used only for immutable Runner job envelopes.
DEVILUDO_RUNNER_JOB_SIGNING_KEY_ID=runner-job-key-01
DEVILUDO_RUNNER_JOB_SIGNING_KEY_FILE=/run/secrets/runner-job-signing/ed25519.pem
DEVILUDO_RUNNER_LEASE_SECONDS=3600

# Dedicated platform supply-chain publisher. Physical Runner certificates are
# not admitted here; only the allow-listed TestKit/toolchain build workload may
# create immutable project-scoped revisions after all bound Runners are online.
DEVILUDO_RUNNER_TOOLCHAIN_HOST=0.0.0.0
DEVILUDO_RUNNER_TOOLCHAIN_PORT=4865
DEVILUDO_RUNNER_TOOLCHAIN_MAX_BODY_BYTES=65536
DEVILUDO_RUNNER_TOOLCHAIN_TLS_KEY_FILE=/run/secrets/runner-toolchain/tls.key
DEVILUDO_RUNNER_TOOLCHAIN_TLS_CERT_FILE=/run/secrets/runner-toolchain/tls.crt
DEVILUDO_RUNNER_TOOLCHAIN_CLIENT_CA_FILE=/run/secrets/runner-toolchain/publisher-ca.crt
DEVILUDO_RUNNER_TOOLCHAIN_ALLOWED_SPIFFE_IDS=["spiffe://deviludo.internal/supply-chain/runner-toolchain"]

# Atomically replaced, at-most-15-minute Runner admission/tenant assignment.
DEVILUDO_RUNNER_FLEET_MANIFEST_FILE=/run/assignments/runner-fleet.json
DEVILUDO_RUNNER_FLEET_KEY_ID=runner-fleet-key-01
# Ed25519 public PEM; its private key remains in the control plane/KMS.
DEVILUDO_RUNNER_FLEET_PUBLIC_KEY=

# Internal evidence archive. It owns S3 credentials; Runner ingress owns none.
DEVILUDO_RUNNER_EVIDENCE_ARCHIVE_URL=https://evidence-archive.internal/v1/runner-evidence
DEVILUDO_RUNNER_EVIDENCE_ARCHIVE_TLS_KEY_FILE=/run/secrets/evidence-archive-client/tls.key
DEVILUDO_RUNNER_EVIDENCE_ARCHIVE_TLS_CERT_FILE=/run/secrets/evidence-archive-client/tls.crt
DEVILUDO_RUNNER_EVIDENCE_ARCHIVE_CA_FILE=/run/secrets/evidence-archive-client/ca.crt
DEVILUDO_RUNNER_EVIDENCE_ARCHIVE_TIMEOUT_SECONDS=30

# Runner workflow destination -> isolated Artifact Preparer. This client
# certificate is separately bound to a short-lived signed tenant assignment.
DEVILUDO_RUNNER_ARTIFACT_PREPARER_URL=https://artifact-preparer.internal:4643
DEVILUDO_RUNNER_ARTIFACT_PREPARER_TLS_KEY_FILE=/run/secrets/runner-control/artifact-preparer-client.key
DEVILUDO_RUNNER_ARTIFACT_PREPARER_TLS_CERT_FILE=/run/secrets/runner-control/artifact-preparer-client.crt
DEVILUDO_RUNNER_ARTIFACT_PREPARER_CA_FILE=/run/secrets/runner-control/artifact-preparer-ca.crt
DEVILUDO_RUNNER_ARTIFACT_PREPARER_TIMEOUT_SECONDS=86400

# Separate Steam-owned clean-install preparation. Only an opaque install grant
# and immutable execution-lock receipt cross this boundary; no password,
# Steam Guard value, branch password or config.vdf enters Runner Control.
DEVILUDO_RUNNER_STEAM_PREPARER_URL=https://steam-workflow-broker.internal:4743
DEVILUDO_RUNNER_STEAM_PREPARER_TLS_KEY_FILE=/run/secrets/runner-control/steam-preparer-client.key
DEVILUDO_RUNNER_STEAM_PREPARER_TLS_CERT_FILE=/run/secrets/runner-control/steam-preparer-client.crt
DEVILUDO_RUNNER_STEAM_PREPARER_CA_FILE=/run/secrets/runner-control/steam-preparer-ca.crt
DEVILUDO_RUNNER_STEAM_PREPARER_TIMEOUT_SECONDS=600

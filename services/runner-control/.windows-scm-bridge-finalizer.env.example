NODE_ENV=production

# Dedicated mTLS identity for the Windows SCM bridge release finalizer. The
# private Ed25519 release key remains inside the approved KMS signer.
DEVILUDO_WINDOWS_SCM_BRIDGE_SIGNER_ENDPOINT=https://windows-scm-bridge-kms.internal:8443
DEVILUDO_WINDOWS_SCM_BRIDGE_SIGNING_KEY_ID=windows-scm-bridge-release-01
DEVILUDO_WINDOWS_SCM_BRIDGE_SIGNER_TLS_KEY_FILE=/run/secrets/windows-scm-bridge-finalizer/tls.key
DEVILUDO_WINDOWS_SCM_BRIDGE_SIGNER_TLS_CERT_FILE=/run/secrets/windows-scm-bridge-finalizer/tls.crt
DEVILUDO_WINDOWS_SCM_BRIDGE_SIGNER_TLS_CA_FILE=/run/secrets/windows-scm-bridge-finalizer/ca.crt

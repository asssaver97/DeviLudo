NODE_ENV=production

# This identity and KMS key are deliberately separate from the Windows service
# bridge signer. The finalizer receives only public claims and mTLS material.
DEVILUDO_WINDOWS_SCM_ACTUATOR_SIGNER_ENDPOINT=https://windows-scm-actuator-kms.internal:8443
DEVILUDO_WINDOWS_SCM_ACTUATOR_SIGNING_KEY_ID=windows-scm-actuator-release-01
DEVILUDO_WINDOWS_SCM_ACTUATOR_SIGNER_TLS_KEY_FILE=/run/secrets/windows-scm-actuator-finalizer/tls.key
DEVILUDO_WINDOWS_SCM_ACTUATOR_SIGNER_TLS_CERT_FILE=/run/secrets/windows-scm-actuator-finalizer/tls.crt
DEVILUDO_WINDOWS_SCM_ACTUATOR_SIGNER_TLS_CA_FILE=/run/secrets/windows-scm-actuator-finalizer/ca.crt

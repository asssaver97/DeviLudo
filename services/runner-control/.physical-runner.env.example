NODE_ENV=production

# Root-owned strict JSON; see physical-runner.config.example.json.
DEVILUDO_PHYSICAL_RUNNER_CONFIG_FILE=/etc/deviludo/physical-runner.json

# Runner-side mTLS connection to the isolated ingress.
DEVILUDO_RUNNER_INGRESS_URL=https://runner-control.internal
DEVILUDO_PHYSICAL_RUNNER_TLS_KEY_FILE=/run/secrets/physical-runner/tls.key
DEVILUDO_PHYSICAL_RUNNER_TLS_CERT_FILE=/run/secrets/physical-runner/tls.crt
DEVILUDO_PHYSICAL_RUNNER_CA_FILE=/run/secrets/physical-runner/runner-control-ca.crt
DEVILUDO_PHYSICAL_RUNNER_REQUEST_TIMEOUT_SECONDS=30

# The same short-lived, Ed25519-signed fleet assignment enforced by ingress.
# It is atomically replaced before its <=15 minute expiry and reverified by the
# physical host before every register/lease cycle. The machine JSON contains no
# tenant IDs. Keep the private signing key off the Runner.
DEVILUDO_RUNNER_FLEET_MANIFEST_FILE=/etc/deviludo/runner-fleet.json
DEVILUDO_RUNNER_FLEET_KEY_ID=runner-fleet-key-01
DEVILUDO_RUNNER_FLEET_PUBLIC_KEY=<PEM-encoded-Ed25519-public-key>

# Public Ed25519 key for server-issued Runner jobs.
DEVILUDO_RUNNER_JOB_VERIFY_KEY_ID=runner-job-key-01
DEVILUDO_RUNNER_JOB_VERIFY_PUBLIC_KEY_FILE=/etc/deviludo/runner-job-ed25519.pub

# Machine-local durable state. The raw HMAC key file must contain 32-64 bytes.
DEVILUDO_PHYSICAL_RUNNER_JOURNAL_ROOT=/var/lib/deviludo-runner/journal
DEVILUDO_PHYSICAL_RUNNER_JOURNAL_HMAC_KEY_FILE=/run/secrets/physical-runner/journal-hmac.key

# Platform-owned, read-only TestKit controller and exact digest.
DEVILUDO_PHYSICAL_RUNNER_TESTKIT_EXECUTABLE=/opt/deviludo-testkit/bin/deviludo-testkit
DEVILUDO_PHYSICAL_RUNNER_TESTKIT_DIGEST=<64-lowercase-hex>
DEVILUDO_PHYSICAL_RUNNER_GODOT_EXECUTABLE=/opt/godot/godot
DEVILUDO_PHYSICAL_RUNNER_WORK_ROOT=/var/lib/deviludo-runner/work
DEVILUDO_PHYSICAL_RUNNER_TESTKIT_TIMEOUT_SECONDS=3600

# The platform-owned TestKit uses the Runner workload certificate only through
# these explicit file paths. It receives no other host process credentials.
DEVILUDO_TESTKIT_ARTIFACT_BROKER_URL=https://evidence-archive.internal
DEVILUDO_TESTKIT_ARTIFACT_TLS_KEY_FILE=/run/secrets/physical-runner/tls.key
DEVILUDO_TESTKIT_ARTIFACT_TLS_CERT_FILE=/run/secrets/physical-runner/tls.crt
DEVILUDO_TESTKIT_ARTIFACT_CA_FILE=/run/secrets/physical-runner/evidence-archive-ca.crt
DEVILUDO_TESTKIT_TRANSFER_CA_FILE=/run/secrets/physical-runner/s3-ca.crt
DEVILUDO_TESTKIT_ALLOWED_TRANSFER_ORIGINS_JSON=["https://s3.internal"]

# Platform-local, Agent-free Steam Client connector. It resolves only the
# opaque install grant from the signed job and must use a fresh client sandbox.
# Steam account/session material remains inside the isolated Steam boundary.
DEVILUDO_TESTKIT_STEAM_CONNECTOR_URL=https://steam-install-connector.internal:4843
DEVILUDO_TESTKIT_STEAM_TLS_KEY_FILE=/run/secrets/testkit-steam/client.key
DEVILUDO_TESTKIT_STEAM_TLS_CERT_FILE=/run/secrets/testkit-steam/client.crt
DEVILUDO_TESTKIT_STEAM_CA_FILE=/run/secrets/testkit-steam/ca.crt
DEVILUDO_TESTKIT_STEAM_STAGING_ROOT=/var/lib/deviludo/steam-installs
DEVILUDO_TESTKIT_STEAM_TIMEOUT_SECONDS=3000
DEVILUDO_PHYSICAL_RUNNER_STEAM_CONNECTOR_VERSION=1.0.0
DEVILUDO_PHYSICAL_RUNNER_STEAM_BRIDGE_VERSION=1.0.3
DEVILUDO_PHYSICAL_RUNNER_STEAM_CONTROLLER_CONTRACT_VERSION=1
DEVILUDO_PHYSICAL_RUNNER_STEAM_CONNECTOR_BINARY_DIGEST=<64-lowercase-hex>
DEVILUDO_PHYSICAL_RUNNER_STEAM_AUTOMATION_POLICY_DIGEST=<64-lowercase-hex>
DEVILUDO_PHYSICAL_RUNNER_STEAM_SUPPLY_CHAIN_EVIDENCE_DIGEST=<64-lowercase-hex>
DEVILUDO_TESTKIT_ARTIFACT_REQUEST_TIMEOUT_SECONDS=30
DEVILUDO_TESTKIT_ARTIFACT_TRANSFER_TIMEOUT_SECONDS=7200
DEVILUDO_TESTKIT_MAX_INPUT_BYTES=17179869184

DEVILUDO_PHYSICAL_RUNNER_POLL_SECONDS=5
DEVILUDO_PHYSICAL_RUNNER_MAX_BACKOFF_SECONDS=60

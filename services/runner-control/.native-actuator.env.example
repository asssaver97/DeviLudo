NODE_ENV=production

# Immutable Ed25519 trust anchor for database-authorized, zero-lease Runner
# upgrade grants. The private key remains in the Runner ingress signer/KMS.
DEVILUDO_RUNNER_NATIVE_ACTUATOR_KEY_ID=runner-job-key-01
DEVILUDO_RUNNER_NATIVE_ACTUATOR_PUBLIC_KEY_FILE=/run/trust/runner-native-actuator/runner-job-ed25519.pub.pem

# The actuator reports a local rollback through the old Runner workload
# identity before sealing its local receipt.
DEVILUDO_RUNNER_INGRESS_URL=https://runner-control.internal
DEVILUDO_PHYSICAL_RUNNER_TLS_KEY_FILE=/run/secrets/physical-runner/tls.key
DEVILUDO_PHYSICAL_RUNNER_TLS_CERT_FILE=/run/secrets/physical-runner/tls.crt
DEVILUDO_PHYSICAL_RUNNER_CA_FILE=/run/secrets/physical-runner/runner-control-ca.crt
DEVILUDO_PHYSICAL_RUNNER_REQUEST_TIMEOUT_SECONDS=30

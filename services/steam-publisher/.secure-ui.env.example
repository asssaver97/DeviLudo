# Browser-facing isolated Steam Secure UI. The edge proxy must route exactly:
#   /enrollments/*
#   /approvals/*
#   /projects/*/steam-configuration/*
#   /v1/steam-ui/*
# to this process on the same external origin as the platform __Host- cookies.
NODE_ENV=production
DEVILUDO_STEAM_SECURE_UI_HOST=0.0.0.0
DEVILUDO_STEAM_SECURE_UI_PORT=4576
DEVILUDO_STEAM_SECURE_UI_REQUEST_TIMEOUT_MS=45000
DEVILUDO_STEAM_SECURE_UI_DEPENDENCY_TIMEOUT_MS=30000
DEVILUDO_STEAM_SECURE_UI_PUBLIC_ORIGIN=https://app.deviludo.example/

DEVILUDO_STEAM_SECURE_UI_TLS_KEY_FILE=/run/secrets/steam-secure-ui/tls.key
DEVILUDO_STEAM_SECURE_UI_TLS_CERT_FILE=/run/secrets/steam-secure-ui/tls.crt

# Dedicated mTLS identity accepted by the platform Identity Broker as a Web
# assertion consumer. It never receives GitHub OAuth or session signing keys.
DEVILUDO_STEAM_SECURE_UI_IDENTITY_URL=https://identity.internal/
DEVILUDO_STEAM_SECURE_UI_IDENTITY_TLS_KEY_FILE=/run/secrets/steam-secure-ui/identity.key
DEVILUDO_STEAM_SECURE_UI_IDENTITY_TLS_CERT_FILE=/run/secrets/steam-secure-ui/identity.crt
DEVILUDO_STEAM_SECURE_UI_IDENTITY_CA_FILE=/run/secrets/steam-secure-ui/identity-ca.crt

# A different mTLS identity is the only caller admitted to the interactive
# binary-secret and MFA-completion routes on start:steam-access.
DEVILUDO_STEAM_SECURE_UI_ACCESS_URL=https://steam-access.internal/
DEVILUDO_STEAM_SECURE_UI_ACCESS_TLS_KEY_FILE=/run/secrets/steam-secure-ui/access.key
DEVILUDO_STEAM_SECURE_UI_ACCESS_TLS_CERT_FILE=/run/secrets/steam-secure-ui/access.crt
DEVILUDO_STEAM_SECURE_UI_ACCESS_CA_FILE=/run/secrets/steam-secure-ui/access-ca.crt

# The MFA service creates one approval/user-bound WebAuthn challenge. The same
# service later validates the assertion through the internal Access Broker.
DEVILUDO_STEAM_SECURE_UI_MFA_URL=https://mfa-verifier.internal/
DEVILUDO_STEAM_SECURE_UI_MFA_TLS_KEY_FILE=/run/secrets/steam-secure-ui/mfa.key
DEVILUDO_STEAM_SECURE_UI_MFA_TLS_CERT_FILE=/run/secrets/steam-secure-ui/mfa.crt
DEVILUDO_STEAM_SECURE_UI_MFA_CA_FILE=/run/secrets/steam-secure-ui/mfa-ca.crt

# Private key exists only here; start:steam-access mounts the matching public key.
DEVILUDO_STEAM_UI_SESSION_KEY_ID=steam-ui-key-2026-07
DEVILUDO_STEAM_UI_SESSION_PRIVATE_KEY_FILE=/run/secrets/steam-secure-ui/session-private.pem

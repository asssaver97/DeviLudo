DATABASE_URL=postgresql://deviludo@postgres/deviludo
DEVILUDO_STEAM_INSTALL_SERVICES_HOST=0.0.0.0
DEVILUDO_STEAM_INSTALL_PREPARER_PORT=4743
DEVILUDO_STEAM_INSTALL_GRANTS_PORT=4744
DEVILUDO_STEAM_INSTALL_GRANT_TTL_SECONDS=10800
DEVILUDO_STEAM_INSTALL_PREPARER_TLS_KEY_FILE=/run/secrets/steam-preparer/server.key
DEVILUDO_STEAM_INSTALL_PREPARER_TLS_CERT_FILE=/run/secrets/steam-preparer/server.crt
DEVILUDO_STEAM_INSTALL_PREPARER_CLIENT_CA_FILE=/run/secrets/steam-preparer/runner-control-ca.crt
DEVILUDO_STEAM_INSTALL_PREPARER_RUNNER_CONTROL_SPIFFE_ID=spiffe://deviludo.internal/runner-control
DEVILUDO_STEAM_INSTALL_PREPARER_ASSIGNMENT_MANIFEST_FILE=/run/config/runner-control-assignments.json
DEVILUDO_STEAM_INSTALL_PREPARER_ASSIGNMENT_KEY_ID=assignment-key-01
DEVILUDO_STEAM_INSTALL_PREPARER_ASSIGNMENT_PUBLIC_KEY_FILE=/run/secrets/steam-preparer/assignment.pub
DEVILUDO_STEAM_INSTALL_GRANTS_TLS_KEY_FILE=/run/secrets/steam-grants/server.key
DEVILUDO_STEAM_INSTALL_GRANTS_TLS_CERT_FILE=/run/secrets/steam-grants/server.crt
DEVILUDO_STEAM_INSTALL_GRANTS_CLIENT_CA_FILE=/run/secrets/steam-grants/connector-ca.crt
DEVILUDO_STEAM_INSTALL_GRANTS_RUNNER_JOB_KEY_ID=runner-job-key-01
DEVILUDO_STEAM_INSTALL_GRANTS_RUNNER_JOB_PUBLIC_KEY_FILE=/run/secrets/steam-grants/runner-job.pub
DEVILUDO_STEAM_INSTALL_GRANTS_RUNNER_FLEET_KEY_ID=runner-fleet-key-01
DEVILUDO_STEAM_INSTALL_GRANTS_RUNNER_FLEET_PUBLIC_KEY_FILE=/run/secrets/steam-grants/runner-fleet.pub
DEVILUDO_STEAM_INSTALL_GRANTS_RUNNER_FLEET_MANIFEST_FILE=/run/config/runner-fleet.json

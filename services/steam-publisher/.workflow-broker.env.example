NODE_ENV=production
DATABASE_URL=postgresql://deviludo-broker@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----replace-with-mounted-ca-----END CERTIFICATE-----
DEVILUDO_STEAM_WORKFLOW_BROKER_SERVER_HOST=0.0.0.0
DEVILUDO_STEAM_WORKFLOW_BROKER_SERVER_PORT=4745
DEVILUDO_STEAM_WORKFLOW_BROKER_SERVER_TLS_KEY_FILE=/run/secrets/steam-workflow-broker/tls.key
DEVILUDO_STEAM_WORKFLOW_BROKER_SERVER_TLS_CERT_FILE=/run/secrets/steam-workflow-broker/tls.crt
DEVILUDO_STEAM_WORKFLOW_BROKER_SERVER_CLIENT_CA_FILE=/run/secrets/steam-workflow-broker/temporal-client-ca.crt
DEVILUDO_STEAM_WORKFLOW_BROKER_SERVER_ALLOWED_SPIFFE_IDS=["spiffe://deviludo.internal/workload/temporal-steam-publisher"]
DEVILUDO_STEAM_WORKFLOW_BROKER_SERVER_VERSION=1.0.0
DEVILUDO_STEAM_WORKFLOW_BROKER_SERVER_BINARY_DIGEST=replace-with-64-lowercase-hex-image-digest
DEVILUDO_STEAM_WORKFLOW_BROKER_SERVER_MAX_BODY_BYTES=524288
DEVILUDO_STEAM_WORKFLOW_BROKER_SERVER_REQUEST_TIMEOUT_MS=30000

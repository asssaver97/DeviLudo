# Isolated Steam enrollment + release MFA access broker.
# Secrets and public keys must be absolute, read-only file mounts; never inline values.
NODE_ENV=production
DEVILUDO_STEAM_ACCESS_HOST=0.0.0.0
DEVILUDO_STEAM_ACCESS_PORT=4575
DEVILUDO_STEAM_ACCESS_REQUEST_TIMEOUT_MS=45000
DEVILUDO_STEAM_ACCESS_DEPENDENCY_TIMEOUT_MS=30000

DEVILUDO_STEAM_ACCESS_TLS_KEY_FILE=/run/secrets/steam-access/tls.key
DEVILUDO_STEAM_ACCESS_TLS_CERT_FILE=/run/secrets/steam-access/tls.crt
DEVILUDO_STEAM_ACCESS_CLIENT_CA_FILE=/run/secrets/steam-access/client-ca.crt
DEVILUDO_STEAM_ACCESS_WEB_SPIFFE_IDS=spiffe://deviludo.internal/workload/web
DEVILUDO_STEAM_ACCESS_UI_SPIFFE_IDS=spiffe://deviludo.internal/workload/steam-secure-ui
DEVILUDO_STEAM_ACCESS_PUBLIC_ORIGIN=https://steam-access.deviludo.example/

# One outbound workload identity is accepted only by these fixed internal services.
DEVILUDO_STEAM_ACCESS_DEPENDENCY_TLS_KEY_FILE=/run/secrets/steam-access/dependency.key
DEVILUDO_STEAM_ACCESS_DEPENDENCY_TLS_CERT_FILE=/run/secrets/steam-access/dependency.crt
DEVILUDO_STEAM_ACCESS_DEPENDENCY_CA_FILE=/run/secrets/steam-access/dependency-ca.crt
DEVILUDO_STEAM_LOGIN_CONNECTOR_URL=https://steam-login.internal/
DEVILUDO_STEAM_CONFIG_VAULT_URL=https://steam-config-vault.internal/
DEVILUDO_STEAM_MFA_VERIFIER_URL=https://mfa-verifier.internal/
DEVILUDO_STEAM_AUTHORIZATION_SIGNER_URL=https://kms.internal/

# Only public verification keys are mounted into the Broker.
DEVILUDO_STEAM_UI_SESSION_KEY_ID=steam-ui-key-2026-07
DEVILUDO_STEAM_UI_SESSION_PUBLIC_KEY_FILE=/run/secrets/steam-access/ui-session-public.pem
DEVILUDO_STEAM_AUTHORIZATION_KEY_ID=steam-publish-key-2026-07
DEVILUDO_STEAM_AUTHORIZATION_PUBLIC_KEY_FILE=/run/secrets/steam-access/publish-authorization-public.pem

DATABASE_URL=postgresql://deviludo_runtime@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----
DEVILUDO_WORKFLOW_POSTGRES_POOL_SIZE=10

TEMPORAL_ADDRESS=temporal.internal:7233
TEMPORAL_NAMESPACE=deviludo
DEVILUDO_TEMPORAL_TLS_CA_FILE=/run/secrets/temporal/ca.pem
DEVILUDO_TEMPORAL_TLS_CERT_FILE=/run/secrets/temporal/client.crt
DEVILUDO_TEMPORAL_TLS_KEY_FILE=/run/secrets/temporal/client.key
DEVILUDO_TEMPORAL_TLS_SERVER_NAME=temporal.internal

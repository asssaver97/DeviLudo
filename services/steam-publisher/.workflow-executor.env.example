NODE_ENV=production
DATABASE_URL=postgresql://deviludo@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
DEVILUDO_STEAM_WORKER_TENANT_IDS=["11111111-1111-4111-8111-111111111111"]
DEVILUDO_STEAM_WORKER_LEASE_MS=300000
DEVILUDO_STEAM_WORKER_POLL_INTERVAL_MS=1000
DEVILUDO_STEAM_WORKER_RETRY_INTERVAL_MS=5000

# Audited native publisher artifact and its fixed non-secret configuration.
DEVILUDO_STEAM_EXECUTOR_NATIVE_EXECUTABLE=/opt/deviludo/bin/native-steam-publisher
DEVILUDO_STEAM_EXECUTOR_NATIVE_EXECUTABLE_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DEVILUDO_STEAM_EXECUTOR_NATIVE_CONFIG_FILE=/opt/deviludo/config/native-steam-publisher.json
DEVILUDO_STEAM_EXECUTOR_NATIVE_CONFIG_DIGEST=bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
DEVILUDO_STEAM_EXECUTOR_WORK_ROOT=/var/lib/deviludo/steam-publisher
DEVILUDO_STEAM_EXECUTOR_NATIVE_TIMEOUT_SECONDS=3300

# Vault/KMS RC signing endpoint. Only the public verification key enters this process.
DEVILUDO_STEAM_EXECUTOR_RC_SIGNER_URL=https://steam-rc-signer.internal
DEVILUDO_STEAM_EXECUTOR_RC_SIGNER_KEY_ID=steam-rc-key-2026-07
DEVILUDO_STEAM_EXECUTOR_RC_SIGNER_PUBLIC_KEY_FILE=/run/secrets/deviludo/steam-rc-public.pem
DEVILUDO_STEAM_EXECUTOR_RC_SIGNER_TLS_KEY_FILE=/run/secrets/deviludo/steam-rc-signer-client.key
DEVILUDO_STEAM_EXECUTOR_RC_SIGNER_TLS_CERT_FILE=/run/secrets/deviludo/steam-rc-signer-client.crt
DEVILUDO_STEAM_EXECUTOR_RC_SIGNER_CA_FILE=/run/secrets/deviludo/steam-rc-signer-ca.crt
DEVILUDO_STEAM_EXECUTOR_RC_SIGNER_TIMEOUT_SECONDS=30

# Credential-isolated native release finalizer. It reads the exact immutable
# Runner export, applies Linux Sigstore / Windows Authenticode / macOS Developer
# ID signing, requires Apple notarization for macOS, and writes only
# content-addressed artifacts plus public verification evidence. Use a distinct
# mTLS workload identity from the RC JSON signer.
DEVILUDO_STEAM_EXECUTOR_DEPOT_FINALIZER_URL=https://steam-depot-finalizer.internal
DEVILUDO_STEAM_EXECUTOR_DEPOT_FINALIZER_TLS_KEY_FILE=/run/secrets/deviludo/depot-finalizer-client.key
DEVILUDO_STEAM_EXECUTOR_DEPOT_FINALIZER_TLS_CERT_FILE=/run/secrets/deviludo/depot-finalizer-client.crt
DEVILUDO_STEAM_EXECUTOR_DEPOT_FINALIZER_CA_FILE=/run/secrets/deviludo/depot-finalizer-ca.crt
DEVILUDO_STEAM_EXECUTOR_DEPOT_FINALIZER_TIMEOUT_SECONDS=1800

# Public key used to verify the separate short-lived MFA publish authorization.
DEVILUDO_STEAM_EXECUTOR_AUTHORIZATION_KEY_ID=steam-authorization-key-2026-07
DEVILUDO_STEAM_EXECUTOR_AUTHORIZATION_PUBLIC_KEY_FILE=/run/secrets/deviludo/steam-authorization-public.pem

# Read-only access to immutable RC exports. The secret is file-mounted, never inline.
DEVILUDO_STEAM_EXECUTOR_S3_ENDPOINT=https://s3.internal
DEVILUDO_STEAM_EXECUTOR_S3_BUCKET=deviludo-evidence
DEVILUDO_STEAM_EXECUTOR_S3_REGION=cn-internal-1
DEVILUDO_STEAM_EXECUTOR_S3_ACCESS_KEY_ID=replace-with-scoped-access-key-id
DEVILUDO_STEAM_EXECUTOR_S3_SECRET_KEY_FILE=/run/secrets/deviludo/steam-executor-s3-secret
DEVILUDO_STEAM_EXECUTOR_S3_CA_FILE=/run/secrets/deviludo/s3-ca.crt
DEVILUDO_STEAM_EXECUTOR_S3_TIMEOUT_SECONDS=30

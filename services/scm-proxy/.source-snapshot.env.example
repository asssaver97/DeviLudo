NODE_ENV=production

DEVILUDO_SOURCE_SNAPSHOT_HOST=0.0.0.0
DEVILUDO_SOURCE_SNAPSHOT_PORT=4543
DEVILUDO_SOURCE_SNAPSHOT_TLS_KEY_FILE=/run/secrets/source-snapshot/tls.key
DEVILUDO_SOURCE_SNAPSHOT_TLS_CERT_FILE=/run/secrets/source-snapshot/tls.crt
DEVILUDO_SOURCE_SNAPSHOT_CLIENT_CA_FILE=/run/secrets/source-snapshot/artifact-preparer-ca.crt
DEVILUDO_SOURCE_SNAPSHOT_ARTIFACT_PREPARER_SPIFFE_ID=spiffe://deviludo.internal/artifact-preparer
# One or more comma-separated Agent Configuration service identities may call
# only the default-branch baseline route. They cannot request source archives.
DEVILUDO_SOURCE_BASELINE_AGENT_CONFIGURATION_SPIFFE_IDS=spiffe://deviludo.internal/agent-configuration

# Atomically replaced, at-most-15-minute tenant assignment bound to the current
# Artifact Preparer certificate fingerprint.
DEVILUDO_SOURCE_SNAPSHOT_ASSIGNMENT_MANIFEST_FILE=/run/assignments/artifact-preparer-tenants.json
DEVILUDO_SOURCE_SNAPSHOT_ASSIGNMENT_KEY_ID=prepared-input-assignments-key-01
DEVILUDO_SOURCE_SNAPSHOT_ASSIGNMENT_PUBLIC_KEY_FILE=/run/secrets/source-snapshot/prepared-input-assignments-ed25519.pub

# The GitHub App RSA private key remains inside Vault/KMS. This service receives
# only an mTLS signing receipt for a bounded App JWT signing input.
DEVILUDO_SOURCE_SNAPSHOT_SIGNER_URL=https://vault-signing.internal:8443
DEVILUDO_SOURCE_SNAPSHOT_SIGNER_KEY_ID=github-app-rsa-v3
DEVILUDO_SOURCE_SNAPSHOT_SIGNER_TLS_KEY_FILE=/run/secrets/source-snapshot/signer-client.key
DEVILUDO_SOURCE_SNAPSHOT_SIGNER_TLS_CERT_FILE=/run/secrets/source-snapshot/signer-client.crt
DEVILUDO_SOURCE_SNAPSHOT_SIGNER_CA_FILE=/run/secrets/source-snapshot/signer-ca.crt
DEVILUDO_SOURCE_SNAPSHOT_SIGNER_TIMEOUT_SECONDS=30
DEVILUDO_SOURCE_SNAPSHOT_GITHUB_APP_ID=778899
DEVILUDO_SOURCE_SNAPSHOT_GITHUB_TIMEOUT_SECONDS=30

DATABASE_URL=postgresql://deviludo-source-snapshot@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_SOURCE_SNAPSHOT_S3_ENDPOINT=https://minio.internal:9000
DEVILUDO_SOURCE_SNAPSHOT_S3_BUCKET=deviludo-evidence
DEVILUDO_SOURCE_SNAPSHOT_S3_REGION=us-east-1
DEVILUDO_SOURCE_SNAPSHOT_S3_ACCESS_KEY_FILE=/run/secrets/source-snapshot/s3-access-key
DEVILUDO_SOURCE_SNAPSHOT_S3_SECRET_KEY_FILE=/run/secrets/source-snapshot/s3-secret-key
DEVILUDO_SOURCE_SNAPSHOT_S3_CA_FILE=/run/secrets/source-snapshot/s3-ca.crt
DEVILUDO_SOURCE_SNAPSHOT_S3_TIMEOUT_SECONDS=30
DEVILUDO_SOURCE_SNAPSHOT_TRANSFER_TIMEOUT_SECONDS=7200
DEVILUDO_SOURCE_SNAPSHOT_WORK_ROOT=/var/lib/deviludo/source-snapshot-work

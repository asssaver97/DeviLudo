NODE_ENV=production
DATABASE_URL=postgresql://deviludo-scm-candidate@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_SCM_CANDIDATE_SERVER_HOST=0.0.0.0
DEVILUDO_SCM_CANDIDATE_SERVER_PORT=4545
DEVILUDO_SCM_CANDIDATE_SERVER_MAX_BODY_BYTES=146800640
DEVILUDO_SCM_CANDIDATE_SERVER_REQUEST_TIMEOUT_MS=600000
DEVILUDO_SCM_CANDIDATE_SERVER_VERSION=1.0.0
DEVILUDO_SCM_CANDIDATE_SERVER_BINARY_DIGEST=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
DEVILUDO_SCM_CANDIDATE_SERVER_ALLOWED_SPIFFE_IDS=["spiffe://deviludo.internal/service/agent-execution-worker"]
DEVILUDO_SCM_CANDIDATE_SERVER_TLS_KEY_FILE=/run/secrets/scm-candidate-server.key
DEVILUDO_SCM_CANDIDATE_SERVER_TLS_CERT_FILE=/run/secrets/scm-candidate-server.crt
DEVILUDO_SCM_CANDIDATE_SERVER_CLIENT_CA_FILE=/run/secrets/workload-ca.crt

DEVILUDO_GITHUB_APP_ID=12345
DEVILUDO_GITHUB_API_TIMEOUT_MS=30000
DEVILUDO_GITHUB_APP_SIGNER_URL=https://kms-broker.internal/
DEVILUDO_GITHUB_APP_SIGNER_KEY_ID=github-app-rs256-v1
DEVILUDO_GITHUB_APP_SIGNER_TLS_KEY_FILE=/run/secrets/github-signer-client.key
DEVILUDO_GITHUB_APP_SIGNER_TLS_CERT_FILE=/run/secrets/github-signer-client.crt
DEVILUDO_GITHUB_APP_SIGNER_CA_FILE=/run/secrets/kms-ca.crt
DEVILUDO_GITHUB_CANDIDATE_ATTESTATION_KEY_ID=worker-attestation-v1
DEVILUDO_GITHUB_CANDIDATE_ATTESTATION_PUBLIC_KEY_FILE=/run/keys/worker-attestation-v1.pem
DEVILUDO_GITHUB_ACCEPTANCE_KEY_ID=acceptance-v1
DEVILUDO_GITHUB_ACCEPTANCE_PUBLIC_KEY_FILE=/run/keys/acceptance-v1.pem

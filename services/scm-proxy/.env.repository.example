NODE_ENV=production
DATABASE_URL=postgresql://deviludo-project-repository@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_PROJECT_REPOSITORY_HOST=0.0.0.0
DEVILUDO_PROJECT_REPOSITORY_PORT=4559
DEVILUDO_PROJECT_REPOSITORY_REQUEST_TIMEOUT_MS=30000
DEVILUDO_PROJECT_REPOSITORY_WEB_SPIFFE_IDS=spiffe://deviludo.internal/web
DEVILUDO_PROJECT_REPOSITORY_TLS_KEY_FILE=/run/secrets/project-repository-server.key
DEVILUDO_PROJECT_REPOSITORY_TLS_CERT_FILE=/run/secrets/project-repository-server.crt
DEVILUDO_PROJECT_REPOSITORY_CLIENT_CA_FILE=/run/secrets/workload-ca.crt

DEVILUDO_GITHUB_APP_ID=12345
DEVILUDO_GITHUB_API_TIMEOUT_MS=15000
DEVILUDO_GITHUB_APP_SIGNER_URL=https://kms-broker.internal/
DEVILUDO_GITHUB_APP_SIGNER_KEY_ID=github-app-rs256-v1
DEVILUDO_GITHUB_APP_SIGNER_TLS_KEY_FILE=/run/secrets/github-app-signer-client.key
DEVILUDO_GITHUB_APP_SIGNER_TLS_CERT_FILE=/run/secrets/github-app-signer-client.crt
DEVILUDO_GITHUB_APP_SIGNER_CA_FILE=/run/secrets/kms-ca.crt

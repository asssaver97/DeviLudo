NODE_ENV=production
DATABASE_URL=postgresql://deviludo-github-auth@postgres.internal:5432/deviludo
DEVILUDO_POSTGRES_TLS_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

DEVILUDO_GITHUB_AUTH_HOST=0.0.0.0
DEVILUDO_GITHUB_AUTH_PORT=4558
DEVILUDO_GITHUB_AUTH_REQUEST_TIMEOUT_MS=30000
DEVILUDO_GITHUB_AUTH_CLAIM_SECONDS=120
DEVILUDO_GITHUB_AUTH_WEB_SPIFFE_IDS=spiffe://deviludo.internal/web
DEVILUDO_GITHUB_AUTH_TLS_KEY_FILE=/run/secrets/github-auth-server.key
DEVILUDO_GITHUB_AUTH_TLS_CERT_FILE=/run/secrets/github-auth-server.crt
DEVILUDO_GITHUB_AUTH_CLIENT_CA_FILE=/run/secrets/workload-ca.crt

DEVILUDO_GITHUB_AUTH_SECRET_BROKER_URL=https://secret-broker.internal/
DEVILUDO_GITHUB_AUTH_SECRET_TLS_KEY_FILE=/run/secrets/secret-broker-client.key
DEVILUDO_GITHUB_AUTH_SECRET_TLS_CERT_FILE=/run/secrets/secret-broker-client.crt
DEVILUDO_GITHUB_AUTH_SECRET_CA_FILE=/run/secrets/secret-broker-ca.crt
DEVILUDO_GITHUB_AUTH_SECRET_TIMEOUT_MS=10000

DEVILUDO_GITHUB_APP_CLIENT_ID=Iv1.replace-with-public-client-id
DEVILUDO_GITHUB_APP_CLIENT_SECRET_REF=vault://kv/github/app-client-secret
DEVILUDO_GITHUB_APP_SLUG=deviludo-example
DEVILUDO_GITHUB_APP_REDIRECT_URI=https://deviludo.example/api/connections/github/callback
DEVILUDO_GITHUB_API_TIMEOUT_MS=15000

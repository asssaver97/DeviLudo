{
  "title": "DeviLudo Local Smoke",
  "testManifest": {
    "schemaVersion": "deviludo.test-manifest.v2",
    "requirements": [
      { "requirementId": "req-core-loop", "description": "玩家完成收集、受伤与胜利核心循环" },
      { "requirementId": "req-pause", "description": "暂停时游戏时间停止流逝" },
      { "requirementId": "req-save", "description": "游戏状态可保存并恢复" },
      { "requirementId": "req-runtime", "description": "运行时保持稳定" }
    ],
    "features": [
      {
        "id": "collect-ember",
        "requirementIds": ["req-core-loop"],
        "category": "core-loop",
        "description": "玩家可以收集余烬道具，重复收集同一道具会被拒绝",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["collect-first-ember", "reject-duplicate-ember"]
      },
      {
        "id": "pause-system",
        "requirementIds": ["req-pause"],
        "category": "player-control",
        "description": "暂停时游戏时间停止流逝",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["pause-stops-clock"]
      },
      {
        "id": "core-loop-journey",
        "requirementIds": ["req-core-loop", "req-pause", "req-save", "req-runtime"],
        "category": "core-loop",
        "description": "在真实窗口中从启动进入游戏并完成核心循环",
        "verificationMethod": "interactive",
        "coreJourney": true,
        "timeoutMs": 300000,
        "interactionScript": {
          "version": "2",
          "events": [
            { "type": "wait", "delay_ms": 1000 },
            { "type": "checkpoint", "id": "game-start", "role": "START", "expectedOutput": "DEVILUDO_E2E_CHECKPOINT:game-start" },
            { "type": "key_press", "key": "KEY_DOWN", "delay_ms": 200 },
            { "type": "key_release", "key": "KEY_DOWN", "delay_ms": 200 },
            { "type": "checkpoint", "id": "menu-selection", "role": "KEY_STATE", "expectedOutput": "DEVILUDO_E2E_CHECKPOINT:menu-selection" },
            { "type": "key_press", "key": "KEY_ENTER", "delay_ms": 200 },
            { "type": "key_release", "key": "KEY_ENTER" },
            { "type": "wait", "delay_ms": 1000 },
            { "type": "checkpoint", "id": "core-loop-complete", "role": "COMPLETION", "expectedOutput": "DEVILUDO_E2E_CHECKPOINT:core-loop-complete" }
          ]
        }
      },
      {
        "id": "damage-system",
        "requirementIds": ["req-core-loop"],
        "category": "core-loop",
        "description": "伤害正确减少船体完整度",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["damage-reduces-hull"]
      },
      {
        "id": "win-condition",
        "requirementIds": ["req-core-loop"],
        "category": "core-loop",
        "description": "收集足够余烬且船体完整时胜利",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["twenty-minute-core-loop-win"]
      },
      {
        "id": "save-persistence",
        "requirementIds": ["req-save"],
        "category": "data-integrity",
        "description": "游戏状态可以保存并原样恢复",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["save-open-write", "save-open-read", "save-json-valid", "save-round-trip"]
      },
      {
        "id": "headless-performance",
        "requirementIds": ["req-runtime"],
        "category": "runtime-quality",
        "description": "headless 模式下测试套件在 250ms 内完成",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["headless-performance-budget"]
      }
    ]
  },
  "assetManifest": {
    "schemaVersion": "deviludo.asset-manifest.v1",
    "items": [
      {
        "assetKey": "ui/ember-icon",
        "assetType": "icon",
        "description": "A compact glowing ember icon used by the collection counter",
        "generationPrompt": "single warm orange ember icon, crisp game UI asset, transparent background, no text",
        "frameCount": null,
        "dimensions": "64x64"
      }
    ]
  }
}

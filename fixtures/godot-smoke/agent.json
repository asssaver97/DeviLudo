{
  "title": "DeviLudo Local Smoke",
  "testManifest": {
    "schemaVersion": "deviludo.test-manifest.v3",
    "requirements": [
      {
        "requirementId": "req-core-loop",
        "description": "玩家完成收集、受伤与胜利核心循环",
        "source": "CORE_LOOP",
        "verificationClass": "PLAYER_INTERACTION"
      },
      {
        "requirementId": "req-pause",
        "description": "暂停时游戏时间停止流逝",
        "source": "ACCEPTANCE",
        "verificationClass": "PLAYER_INTERACTION"
      },
      {
        "requirementId": "req-save",
        "description": "游戏状态可保存并恢复",
        "source": "ACCEPTANCE",
        "verificationClass": "SYSTEM",
        "systemCategory": "DATA",
        "exemptionReason": "存档字节和状态往返属于持久化数据完整性契约"
      },
      {
        "requirementId": "req-runtime",
        "description": "运行时保持稳定",
        "source": "ACCEPTANCE",
        "verificationClass": "SYSTEM",
        "systemCategory": "RUNTIME",
        "exemptionReason": "运行时稳定性由导出程序错误扫描和确定性测试共同验证"
      }
    ],
    "features": [
      {
        "id": "collect-ember",
        "requirementIds": ["req-core-loop"],
        "category": "core-loop",
        "description": "玩家可以收集余烬道具，重复收集同一道具会被拒绝",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["collect-first-ember", "reject-duplicate-ember"]
      },
      {
        "id": "pause-system",
        "requirementIds": ["req-pause"],
        "category": "player-control",
        "description": "暂停时游戏时间停止流逝",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["pause-stops-clock"]
      },
      {
        "id": "core-loop-journey",
        "requirementIds": ["req-core-loop", "req-pause"],
        "category": "core-loop",
        "description": "通过语义控件和真实键鼠选择路线、暂停并完成核心循环",
        "verificationMethod": "interactive",
        "coreJourney": true,
        "launchProfile": { "type": "FRESH" },
        "timeoutMs": 300000,
        "interactionScript": {
          "version": "3",
          "events": [
            {
              "type": "checkpoint",
              "id": "game-start",
              "role": "START",
              "visualMode": "STABLE_REPLAY",
              "expectedOutput": "DEVILUDO_E2E_CHECKPOINT:game-start",
              "assertions": [
                { "source": "SCENE", "operator": "EQUALS", "value": "smoke-main" }
              ],
              "delay_ms": 1000
            },
            {
              "type": "checkpoint",
              "id": "controls-ready",
              "role": "READY",
              "visualMode": "DYNAMIC",
              "assertions": [
                { "source": "CONTROL", "targetId": "route-select", "property": "enabled", "operator": "EQUALS", "value": true }
              ]
            },
            {
              "type": "click",
              "targetId": "route-select",
              "stepId": "select-route",
              "intent": "PRIMARY_ACTION",
              "coversRequirementIds": ["req-core-loop"],
              "postconditions": [
                { "source": "STATE", "key": "route_selected", "operator": "EQUALS", "value": true },
                { "source": "CONTROL", "targetId": "complete-loop", "property": "enabled", "operator": "EQUALS", "value": true }
              ],
              "delay_ms": 200
            },
            {
              "type": "checkpoint",
              "id": "route-selected",
        "role": "ACTION",
        "visualMode": "DYNAMIC",
        "changeTargetId": "route-select",
              "expectedOutput": "DEVILUDO_E2E_CHECKPOINT:route-selected",
              "assertions": [
                { "source": "STATE", "key": "route_selected", "operator": "EQUALS", "value": true }
              ]
            },
            {
              "type": "key_tap",
              "key": "KEY_P",
              "stepId": "pause-game",
              "intent": "FEATURE_ACTION",
              "coversRequirementIds": ["req-pause"],
              "postconditions": [
                { "source": "STATE", "key": "paused", "operator": "EQUALS", "value": true }
              ],
              "delay_ms": 200
            },
            {
              "type": "key_tap",
              "key": "KEY_P",
              "stepId": "resume-game",
              "intent": "NAVIGATION",
              "coversRequirementIds": [],
              "postconditions": [
                { "source": "STATE", "key": "paused", "operator": "EQUALS", "value": false }
              ],
              "delay_ms": 200
            },
            {
              "type": "click",
              "targetId": "complete-loop",
              "stepId": "complete-loop",
              "intent": "COMPLETE_LOOP",
              "coversRequirementIds": ["req-core-loop"],
              "postconditions": [
                { "source": "STATE", "key": "loop_complete", "operator": "EQUALS", "value": true },
                { "source": "PROGRESS", "key": "loop", "operator": "GREATER_THAN", "value": 0 }
              ],
              "delay_ms": 200
            },
            {
              "type": "checkpoint",
              "id": "loop-progressed",
        "role": "PROGRESS",
        "visualMode": "DYNAMIC",
        "changeTargetId": "complete-loop",
              "assertions": [
                { "source": "PROGRESS", "key": "loop", "operator": "EQUALS", "value": 1 }
              ]
            },
            {
              "type": "checkpoint",
              "id": "core-loop-complete",
              "role": "COMPLETION",
              "visualMode": "STABLE_REPLAY",
              "expectedOutput": "DEVILUDO_E2E_CHECKPOINT:core-loop-complete",
              "assertions": [
                { "source": "STATE", "key": "loop_complete", "operator": "EQUALS", "value": true }
              ]
            }
          ]
        }
      },
      {
        "id": "damage-system",
        "requirementIds": ["req-core-loop"],
        "category": "core-loop",
        "description": "伤害正确减少船体完整度",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["damage-reduces-hull"]
      },
      {
        "id": "win-condition",
        "requirementIds": ["req-core-loop"],
        "category": "core-loop",
        "description": "收集足够余烬且船体完整时胜利",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["twenty-minute-core-loop-win"]
      },
      {
        "id": "save-persistence",
        "requirementIds": ["req-save"],
        "category": "data-integrity",
        "description": "游戏状态可以保存并原样恢复",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["save-open-write", "save-open-read", "save-json-valid", "save-round-trip"]
      },
      {
        "id": "headless-performance",
        "requirementIds": ["req-runtime"],
        "category": "runtime-quality",
        "description": "headless 模式下测试套件在 250ms 内完成",
        "verificationMethod": "unit",
        "gdsTestPath": "res://tests/e2e.gd",
        "checkNames": ["headless-performance-budget"]
      }
    ]
  },
  "assetManifest": {
    "schemaVersion": "deviludo.asset-manifest.v1",
    "items": [
      {
        "assetKey": "ui/ember-icon",
        "assetType": "icon",
        "description": "A compact glowing ember icon used by the collection counter",
        "generationPrompt": "single warm orange ember icon, crisp game UI asset, transparent background, no text",
        "frameCount": null,
        "dimensions": "64x64"
      }
    ]
  }
}

# Local integration defaults only. Never place real credentials in this file.
NODE_ENV=development
DEVILUDO_CONTROL_PLANE_HOST=127.0.0.1
DEVILUDO_CONTROL_PLANE_PORT=4100
# These fixed values are disposable localhost defaults. Replace all of them in
# a private `.env` before sharing a machine or exposing any integration port.
DEVILUDO_POSTGRES_PASSWORD=deviludo-local-only
DEVILUDO_REDIS_PASSWORD=deviludo-local-only
DEVILUDO_MINIO_USER=deviludo-local
DEVILUDO_MINIO_PASSWORD=deviludo-local-only
DEVILUDO_VAULT_DEV_TOKEN=deviludo-local-only
DEVILUDO_POSTGRES_PORT=5432
DEVILUDO_REDIS_PORT=6379
DATABASE_URL=postgresql://deviludo:deviludo-local-only@127.0.0.1:5432/deviludo
# Optional loopback-only override used by db:migrate outside production.
# DEVILUDO_MIGRATION_DATABASE_URL=postgresql://deviludo:deviludo-local-only@127.0.0.1:5432/deviludo
# Production migration jobs must not receive DATABASE_URL. Mount a distinct
# owner/migration-role URL and optional TLS material as files instead.
DEVILUDO_MIGRATION_DATABASE_URL_FILE=
DEVILUDO_MIGRATION_POSTGRES_CA_FILE=
DEVILUDO_MIGRATION_POSTGRES_CERT_FILE=
DEVILUDO_MIGRATION_POSTGRES_KEY_FILE=
# Production release promotion only. The authorizer presents this dedicated
# mTLS identity to a fixed Vault/KMS signing Broker. The private signing key
# never enters the repository, CLI process, environment or trust policy. Set an
# origin only; the client fixes the v2 signing path itself.
DEVILUDO_CONTROL_RELEASE_SIGNER_ENDPOINT=
DEVILUDO_CONTROL_RELEASE_SIGNER_TLS_KEY_FILE=
DEVILUDO_CONTROL_RELEASE_SIGNER_TLS_CERT_FILE=
DEVILUDO_CONTROL_RELEASE_SIGNER_TLS_CA_FILE=
DEVILUDO_CONTROL_RELEASE_SIGNING_KEY_ID=
# Production control-plane image only. Choose exactly one service admitted by
# scripts/production/run-control-service.mjs; never use this for native nodes.
# DEVILUDO_SERVICE=control-plane
REDIS_URL=redis://:deviludo-local-only@127.0.0.1:6379
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=deviludo-game-delivery
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=deviludo-evidence
VAULT_ADDR=http://127.0.0.1:8200

# Loopback-only Web and deterministic sidecars. Real Agent execution remains
# fail-closed until every pinned version, image and Gateway value is supplied.
DEVILUDO_LOCAL_PORT=3000
DEVILUDO_LOCAL_RUNTIME_PORT=4311
DEVILUDO_LOCAL_AGENT_RUNTIME_PORT=4312
DEVILUDO_LOCAL_SPEC_RUNTIME_PORT=4313
DEVILUDO_LOCAL_INFERENCE_GATEWAY_PORT=4314
# Shared only by the loopback Agent SCM and Godot verifier; must be absolute
# when the services are started independently. local:dev derives this path.
DEVILUDO_LOCAL_AGENT_STORAGE_ROOT=
# Platform-owned Godot scaffold copied into each local Agent attempt; absolute.
DEVILUDO_LOCAL_AGENT_FIXTURE_ROOT=
# Local-only durable state; the launcher resolves its default under `.deviludo/`.
DEVILUDO_LOCAL_SPEC_STATE_FILE=
DEVILUDO_GODOT_BINARY=
DEVILUDO_GODOT_EXPORT_TEMPLATES_ROOT=
DEVILUDO_LOCAL_CLAUDE_EXPECTED_VERSION=2.1.201
DEVILUDO_LOCAL_CODEX_EXPECTED_VERSION=0.146.0-alpha.3.1
DEVILUDO_LOCAL_AGENT_EXECUTION=0
DEVILUDO_LOCAL_INFERENCE_GATEWAY_URL=
DEVILUDO_WORKER_IMAGE_DIGEST=
DEVILUDO_LOCAL_EXPECTED_WORKER_IMAGE_DIGEST=
DEVILUDO_LOCAL_DETERMINISTIC_WORKER_ATTESTATION=0

# Unified tracing is off for the loopback test site. Every `start:*` production
# process requires OTLP when NODE_ENV=production. Prefer one loopback Collector
# sidecar per workload; the Collector owns upstream TLS/authentication.
DEVILUDO_OTEL_MODE=disabled
DEVILUDO_OTEL_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
DEVILUDO_OTEL_HEALTH_URL=http://127.0.0.1:13133
DEVILUDO_OTEL_TRACE_RATIO=1
DEVILUDO_DEPLOYMENT_ENVIRONMENT=development

# Only references belong in service configuration. Put secret material in Vault.
RUN_TOKEN_SIGNING_KEY_SECRET_REF=vault://transit/keys/deviludo-run-token
GITHUB_APP_PRIVATE_KEY_SECRET_REF=vault://kv/github/app-private-key
STEAM_SESSION_SECRET_REF=vault://kv/steam/build-account/config-vdf
INFERENCE_GATEWAY_BASE_URL=https://inference.internal.deviludo.example

# Public identifiers are safe to configure here.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET_REF=vault://kv/github/app-client-secret
GITHUB_OAUTH_REDIRECT_URI=https://deviludo.example/api/connections/github/callback
GITHUB_API_VERSION=2026-03-10
# Internal mTLS Broker origin. Leave empty to keep public routes fail-closed.
DEVILUDO_GITHUB_AUTH_BROKER_URL=
# Production GitHub authorization Broker (mTLS Web ingress + mTLS Vault facade).
DEVILUDO_GITHUB_AUTH_HOST=0.0.0.0
DEVILUDO_GITHUB_AUTH_PORT=4558
DEVILUDO_GITHUB_AUTH_WEB_SPIFFE_IDS=spiffe://deviludo.internal/web
DEVILUDO_GITHUB_AUTH_TLS_KEY_FILE=
DEVILUDO_GITHUB_AUTH_TLS_CERT_FILE=
DEVILUDO_GITHUB_AUTH_CLIENT_CA_FILE=
DEVILUDO_GITHUB_AUTH_SECRET_BROKER_URL=
DEVILUDO_GITHUB_AUTH_SECRET_TLS_KEY_FILE=
DEVILUDO_GITHUB_AUTH_SECRET_TLS_CERT_FILE=
DEVILUDO_GITHUB_AUTH_SECRET_CA_FILE=
DEVILUDO_GITHUB_APP_REDIRECT_URI=https://deviludo.example/api/connections/github/callback
DEVILUDO_GITHUB_APP_CLIENT_SECRET_REF=vault://kv/github/app-client-secret
# Invite-only account Identity Broker. The Web holds only Secure/HttpOnly
# cookies; the Broker returns a fresh route-bound HMAC assertion per API call.
DEVILUDO_IDENTITY_BROKER_URL=
# Separate mesh origin whose egress identity is allow-listed only for invitation
# administration; do not route ordinary Web session traffic through it.
DEVILUDO_IDENTITY_ADMIN_BROKER_URL=
DEVILUDO_IDENTITY_HOST=0.0.0.0
DEVILUDO_IDENTITY_PORT=4560
DEVILUDO_IDENTITY_WEB_SPIFFE_IDS=spiffe://deviludo.internal/web
DEVILUDO_IDENTITY_ADMIN_SPIFFE_IDS=spiffe://deviludo.internal/identity-admin
DEVILUDO_IDENTITY_TLS_KEY_FILE=
DEVILUDO_IDENTITY_TLS_CERT_FILE=
DEVILUDO_IDENTITY_CLIENT_CA_FILE=
DEVILUDO_IDENTITY_SECRET_BROKER_URL=
DEVILUDO_IDENTITY_SECRET_TLS_KEY_FILE=
DEVILUDO_IDENTITY_SECRET_TLS_CERT_FILE=
DEVILUDO_IDENTITY_SECRET_CA_FILE=
DEVILUDO_IDENTITY_GITHUB_REDIRECT_URI=https://deviludo.example/api/auth/github/callback
DEVILUDO_IDENTITY_SESSION_SECONDS=28800
# Project creation Broker. It accepts only a trusted Web workload, resolves
# current GitHub App visibility, and atomically persists project + binding.
DEVILUDO_PROJECT_REPOSITORY_BROKER_URL=
DEVILUDO_PROJECT_REPOSITORY_HOST=0.0.0.0
DEVILUDO_PROJECT_REPOSITORY_PORT=4559
DEVILUDO_PROJECT_REPOSITORY_WEB_SPIFFE_IDS=spiffe://deviludo.internal/web
DEVILUDO_PROJECT_REPOSITORY_TLS_KEY_FILE=
DEVILUDO_PROJECT_REPOSITORY_TLS_CERT_FILE=
DEVILUDO_PROJECT_REPOSITORY_CLIENT_CA_FILE=
# Internal mTLS specification dialogue origin. Local dev injects its own
# loopback URL; never point production at the deterministic local sidecar.
DEVILUDO_SPEC_DIALOGUE_BROKER_URL=
# Internal mTLS user-acceptance origin. It resolves the waiting candidate
# action server-side and commits a new specification draft before invalidation.
DEVILUDO_USER_ACCEPTANCE_BROKER_URL=
# Read-only Temporal state projection Broker. Production Web traffic must carry
# the signed tenant/user session headers and a Web SPIFFE identity at the mesh.
DEVILUDO_DELIVERY_PROJECTION_BROKER_URL=
# Set only by `npm run local:dev`; production rejects local fixtures even if this is accidentally present.
DEVILUDO_LOCAL_TEST_MODE=0
# Launcher-internal split-brain fence: local:dev sets both sides to 1 so the
# Web process can use the Agent sidecar's ephemeral Provider credential store.
# Keep both disabled in production; production uses Secret Broker + Vault/KMS.
DEVILUDO_LOCAL_PROVIDER_CONTROL=0
DEVILUDO_LOCAL_PROVIDER_CONTROL_REQUIRED=0
# 32-64 random bytes encoded as base64url; inject from Vault, never commit it.
DEVILUDO_SESSION_HMAC_KEY=
# Trusted admin ingress assertion key; at least 32 random bytes, standard base64.
DEVILUDO_ADMIN_SESSION_HMAC_KEY=
# Dedicated HTTPS mesh connector for Web -> production Agent administration.
# The connector presents its mTLS workload identity to the control plane. The
# egress HMAC key is separate from the browser/admin-ingress assertion key; set
# the control-plane service's DEVILUDO_ADMIN_SESSION_HMAC_KEY to this value.
DEVILUDO_ADMIN_CONTROL_PLANE_BROKER_URL=
DEVILUDO_ADMIN_CONTROL_PLANE_HMAC_KEY=
# Internal mTLS Steam Access Broker for one-time enrollment and project release configuration.
DEVILUDO_STEAM_ENROLLMENT_BROKER_URL=
# Fixed public HTTPS origin owned by the isolated enrollment broker.
DEVILUDO_STEAM_ENROLLMENT_PUBLIC_ORIGIN=
# Internal MFA signer/Temporal dispatch broker and its fixed public challenge UI.
DEVILUDO_RELEASE_AUTHORIZATION_BROKER_URL=
DEVILUDO_RELEASE_AUTHORIZATION_PUBLIC_ORIGIN=
# Dedicated Agent supply-chain native KMS signer. It signs the exact privileged
# policy artifact, build receipt and scan/provenance evidence envelope.
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_SIGNER_ENDPOINT=
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_SIGNING_KEY_ID=
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_SIGNER_TLS_KEY_FILE=
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_SIGNER_TLS_CERT_FILE=
DEVILUDO_AGENT_SUPPLY_CHAIN_NATIVE_SIGNER_TLS_CA_FILE=
# Dedicated deployment authorization for the privileged Agent supply-chain
# Broker image. This identity, KMS key and fixed signing route are intentionally
# distinct from both native-artifact signing and shared control-plane release.
DEVILUDO_AGENT_SUPPLY_CHAIN_RELEASE_SIGNER_ENDPOINT=
DEVILUDO_AGENT_SUPPLY_CHAIN_RELEASE_SIGNING_KEY_ID=
DEVILUDO_AGENT_SUPPLY_CHAIN_RELEASE_SIGNER_TLS_KEY_FILE=
DEVILUDO_AGENT_SUPPLY_CHAIN_RELEASE_SIGNER_TLS_CERT_FILE=
DEVILUDO_AGENT_SUPPLY_CHAIN_RELEASE_SIGNER_TLS_CA_FILE=
# Dedicated deployment authorization for the credential-image issuer. This
# workload carries Guest certificates and an attestation key, so it uses a
# separate reviewed policy, KMS key and fixed mTLS signing route.
DEVILUDO_AGENT_CREDENTIAL_ISSUER_RELEASE_SIGNER_ENDPOINT=
DEVILUDO_AGENT_CREDENTIAL_ISSUER_RELEASE_SIGNING_KEY_ID=
DEVILUDO_AGENT_CREDENTIAL_ISSUER_RELEASE_SIGNER_TLS_KEY_FILE=
DEVILUDO_AGENT_CREDENTIAL_ISSUER_RELEASE_SIGNER_TLS_CERT_FILE=
DEVILUDO_AGENT_CREDENTIAL_ISSUER_RELEASE_SIGNER_TLS_CA_FILE=

# Dedicated Artifact Preparer release signer. This authority must not share a
# key or mTLS identity with control-plane, Agent, Runner or Steam release paths.
DEVILUDO_ARTIFACT_PREPARER_RELEASE_SIGNER_ENDPOINT=
DEVILUDO_ARTIFACT_PREPARER_RELEASE_SIGNING_KEY_ID=
DEVILUDO_ARTIFACT_PREPARER_RELEASE_SIGNER_TLS_KEY_FILE=
DEVILUDO_ARTIFACT_PREPARER_RELEASE_SIGNER_TLS_CERT_FILE=
DEVILUDO_ARTIFACT_PREPARER_RELEASE_SIGNER_TLS_CA_FILE=

# Dedicated Runner-native KMS signer. The finalizer sends only canonical public
# claims over TLS 1.3 mTLS; private signing material never enters this process.
DEVILUDO_RUNNER_NATIVE_SIGNER_ENDPOINT=
DEVILUDO_RUNNER_NATIVE_SIGNING_KEY_ID=
DEVILUDO_RUNNER_NATIVE_SIGNER_TLS_KEY_FILE=
DEVILUDO_RUNNER_NATIVE_SIGNER_TLS_CERT_FILE=
DEVILUDO_RUNNER_NATIVE_SIGNER_TLS_CA_FILE=
# Production Steam UI bridge manifest finalizer. This is a distinct KMS key and
# mTLS workload from the Runner-native release signer. The finalizer fixes the
# signing route and sends only canonical public claims.
DEVILUDO_STEAM_NATIVE_BRIDGE_SIGNER_ENDPOINT=
DEVILUDO_STEAM_NATIVE_BRIDGE_SIGNING_KEY_ID=
DEVILUDO_STEAM_NATIVE_BRIDGE_SIGNER_TLS_KEY_FILE=
DEVILUDO_STEAM_NATIVE_BRIDGE_SIGNER_TLS_CERT_FILE=
DEVILUDO_STEAM_NATIVE_BRIDGE_SIGNER_TLS_CA_FILE=
STEAM_APP_ID=

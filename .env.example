# The local stack is intentionally self-contained. Production secrets are file-mounted per role.
DEVILUDO_WEB_CORE_TOKEN=replace-with-at-least-32-random-characters
DEVILUDO_E2E_NODE_TOKEN=replace-for-local-development
DEVILUDO_E2E_POOL_KIND=E2E_MACOS
DEVILUDO_E2E_NODE_ID=00000000-0000-4000-8000-000000000005
DEVILUDO_WEB_HOST_PORT=3100
DEVILUDO_CORE_API_URL=http://127.0.0.1:8080
DEVILUDO_ACCESS_MODE=standalone
DEVILUDO_PROJECTS_ROOT=.deviludo/projects
# Platform deployments additionally set DEVILUDO_PLATFORM_ACCOUNT_API_URL and a file-mounted DEVILUDO_PLATFORM_INTERNAL_TOKEN.
